---
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { LessonsDifferentContent } from "../types/content";

interface Props {
  content: LessonsDifferentContent;
}

const { content } = Astro.props;

const headingParts = splitHighlighted(content.heading, ["different"]);

// Fixed decorative accent color tied to card position (not admin-editable
// data), same positional-array convention as Pain Points'/Services' arrays —
// previously the timeline circles' fill, now each card's number-badge color.
const cardAccents = ["var(--color-primary)", "var(--color-primary-dark)", "var(--color-secondary)", "var(--color-tertiary)"];
---

<section id="lessons-different" class="lessons-different">
	<span
		class="lessons-different-stamp"
		aria-hidden="true"
		style={`mask-image:url(${withBase("/images/italy_stamp.svg")});-webkit-mask-image:url(${withBase("/images/italy_stamp.svg")});`}
	></span>
	<div class="container">
		<h2 class="lessons-different-heading">
			{headingParts.map((part) =>
				part.highlight ? (
					<span class="highlight">{part.text}</span>
				) : (
					<>{part.text}</>
				)
			)}
		</h2>
		<div class="lessons-grid">
			{content.steps.map((step, i) => (
				<div class="lessons-card">
					<span class="lessons-card-number" style={`color: ${cardAccents[i % cardAccents.length]}`}>{`0${i + 1}`}</span>
					<h3 class="lessons-card-title">{step.title}</h3>
					<p class="lessons-card-description">{step.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.lessons-different {
		position: relative;
		background: var(--color-primary);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.lessons-different-heading {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		text-align: center;
		color: var(--color-white);
		margin-bottom: 3.5rem;
	}

	.lessons-different-heading .highlight {
		color: var(--color-secondary);
	}

	.lessons-grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 5rem;
	}

	.lessons-card {
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: 2rem 1.5rem;
		min-height: 22rem;
	}

	.lessons-card-number {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
	}

	.lessons-card-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--color-primary-dark);
		margin-bottom: 1.5rem;
	}

	.lessons-card-description {
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	.lessons-different-stamp {
		display: block;
		position: absolute;
		left: 0;
		top: -1rem;
		width: 7rem;
		aspect-ratio: 45.914291 / 44.24184;
		background-color: var(--color-white);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.5;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.lessons-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.lessons-card {
			min-height: 0;
		}

		.lessons-different-stamp {
			left: 1rem;
		}
	}
</style>
