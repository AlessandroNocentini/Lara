---
import PlaceholderImage from "./PlaceholderImage.astro";
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { HowITeachContent } from "../types/content";

interface Props {
  content: HowITeachContent;
}

const { content } = Astro.props;

const headingParts = splitHighlighted(content.heading, ["teach"]);
---

<section id="how-i-teach" class="how-i-teach">
	<div class="how-i-teach-photo">
		<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="rounded" />
	</div>
	<div class="how-i-teach-copy">
		<div class="container how-i-teach-inner">
			<h2 class="how-i-teach-title">
				{headingParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<p class="how-i-teach-text">{content.text}</p>
		</div>
		<span
			class="how-i-teach-stamp"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/spritz_stamp.svg")});-webkit-mask-image:url(${withBase("/images/spritz_stamp.svg")});`}
		></span>
	</div>
</section>

<style>
	.how-i-teach {
		display: grid;
		grid-template-columns: minmax(280px, 45%) 1fr;
		align-items: stretch;
		min-height: 32rem;
	}

	.how-i-teach-photo {
		position: relative;
		height: 100%;
	}

	.how-i-teach-photo :global(.placeholder-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
		/* Fade the photo's right edge into the gradient panel next to it —
		   same technique as Hero's portrait fading into the hero background. */
		mask-image: linear-gradient(to right, black 55%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, black 55%, transparent 100%);
	}

	.how-i-teach-copy {
		position: relative;
		background-color: var(--color-primary);
		background-image: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 88%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 94%, transparent) 100%);
		color: var(--color-white);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.how-i-teach-inner {
		padding-block: var(--section-padding);
	}

	.how-i-teach-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		margin-bottom: 1.25rem;
	}

	.how-i-teach-title .highlight {
		color: var(--color-secondary);
	}

	.how-i-teach-text {
		max-width: 28rem;
		color: rgb(255 255 255 / 0.85);
	}

	.how-i-teach-stamp {
		display: block;
		position: absolute;
		right: clamp(1rem, 4vw, 2.5rem);
		bottom: 1rem;
		width: 3.5rem;
		aspect-ratio: 19.807003 / 49.121681;
		background-color: var(--color-white);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.9;
		rotate: 12deg;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.how-i-teach {
			grid-template-columns: 1fr;
			min-height: auto;
			text-align: center;
		}

		.how-i-teach-photo {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
		}

		.how-i-teach-photo :global(.placeholder-image) {
			mask-image: none;
			-webkit-mask-image: none;
		}

		.how-i-teach-text {
			max-width: none;
			margin-inline: auto;
		}
	}
</style>
