---
interface Props {
  section: string;
}

const { section } = Astro.props;

const icons: Record<string, string> = {
  hero:
    '<path d="M4 11.5 12 4l8 7.5" /><path d="M6 10v9h12v-9" /><path d="M10 19v-5h4v5" />',
  about:
    '<circle cx="12" cy="8" r="3.4" /><path d="M5 20c0-4 3.1-6.5 7-6.5s7 2.5 7 6.5" />',
  "pain-points":
    '<path d="M4 5h16v11H9l-4 4v-4H4z" /><path d="M9.5 9.3c0-1.3 1.1-2.1 2.5-2.1s2.3.8 2.3 1.9c0 1-.6 1.4-1.4 1.9-.6.4-.9.7-.9 1.4" /><circle cx="12" cy="14.6" r="0.15" fill="currentColor" stroke="none" />',
  method:
    '<path d="M12 6c-1.8-1.2-4.4-1.5-7-1v13c2.6-.5 5.2-.2 7 1 1.8-1.2 4.4-1.5 7-1V5c-2.6-.5-5.2-.2-7 1z" /><path d="M12 6v13" />',
  results:
    '<path d="M5 19V10M11 19V5M17 19v-7" /><path d="M4 19h16" />',
  testimonials:
    '<path d="M12 3.5l2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8z" />',
  contact:
    '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" />',
};

const label = section
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
const path = icons[section] ?? icons.hero;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
  set:html={path}
/>
