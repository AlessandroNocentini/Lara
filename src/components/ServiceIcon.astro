---
interface Props {
  icon: string;
}

const { icon } = Astro.props;

const icons: Record<string, string> = {
  private:
    '<circle cx="12" cy="8" r="3.2" /><path d="M6.5 20c0-3.6 2.5-6 5.5-6s5.5 2.4 5.5 6" /><path d="M16.5 4.8c1 .5 1.7 1.5 1.7 2.7 0 1.5-1.1 2.7-2.5 3" />',
  group:
    '<circle cx="9" cy="8.5" r="2.6" /><circle cx="16.5" cy="9.5" r="2.2" /><path d="M4 20c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2" /><path d="M14.5 15.5c2.4.2 4 2.1 4 4.5" />',
  club:
    '<path d="M4 5h11v8H9l-3.5 3.2V13H4z" /><path d="M11 9h9v7h-2.5v2.6L15 16h-4z" />',
  company:
    '<rect x="4" y="10" width="7" height="10" /><rect x="13" y="4" width="7" height="16" /><path d="M6.5 13h2M6.5 16h2M15.5 7h2M15.5 10h2M15.5 13h2M15.5 16h2" />',
};

const labels: Record<string, string> = {
  private: "Private lessons",
  group: "Group lessons",
  club: "Speaking club",
  company: "Lessons for companies",
};

const path = icons[icon] ?? icons.private;
const label = labels[icon] ?? "Service";
---

<svg
  viewBox="0 0 24 24"
  width="28"
  height="28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
  set:html={path}
/>
