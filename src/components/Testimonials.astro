---
import { withBase } from "../utils/baseUrl";
import SectionKicker from "./SectionKicker.astro";
import type { TestimonialsContent } from "../types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;

const AVATARS: Record<string, string> = {
  male: "/images/testimonial_male.svg",
  female: "/images/testimonial_female.svg",
  other: "/images/testimonial_other.svg",
};

function formatDate(iso: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

{content.items.length > 0 && (
	<section id="testimonials" class="testimonials">
		<div class="container">
			<div class="testimonials-heading">
				<SectionKicker label="Reviews" color="var(--color-red)" />
				<h2>{content.title}</h2>
			</div>
			<div class="testimonials-row" role="list">
				{content.items.map((item) => (
					<article class="testimonial-card" data-hover-lift role="listitem">
						<img
							class="testimonial-avatar"
							src={withBase(AVATARS[item.gender] ?? AVATARS.other)}
							alt=""
							aria-hidden="true"
							loading="lazy"
						/>
						<div class="testimonial-bubble">
							<p class="testimonial-text">{item.text}</p>
							<footer class="testimonial-meta">
								<span class="testimonial-name">{item.name}</span>
								<time class="testimonial-date" datetime={item.date}>{formatDate(item.date)}</time>
							</footer>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.testimonials {
		padding: var(--section-padding);
		background: var(--color-cream);
		overflow: hidden;
	}

	.testimonials-heading {
		text-align: center;
		margin-bottom: 2rem;
	}

	h2 {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		color: var(--color-teal-dark);
	}

	.testimonials-row {
		display: flex;
		gap: 1.5rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		padding: 1.5rem 0.25rem 1rem;
		margin: 0 -0.25rem;
		scrollbar-width: thin;
		scrollbar-color: var(--color-teal) transparent;
	}

	.testimonial-card {
		position: relative;
		flex: 0 0 auto;
		scroll-snap-align: start;
		width: clamp(240px, 70vw, 320px);
		padding-top: 2.25rem;
	}

	.testimonial-avatar {
		position: absolute;
		top: 0;
		left: 1.5rem;
		width: 3.5rem;
		height: auto;
		z-index: 1;
	}

	.testimonial-bubble {
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: 2rem 1.5rem 1.25rem;
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.testimonial-text {
		color: var(--color-ink-soft);
		font-size: 0.95rem;
		flex: 1;
	}

	.testimonial-meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		border-top: 1px solid rgb(15 118 110 / 0.12);
		padding-top: 0.6rem;
	}

	.testimonial-name {
		font-weight: 700;
		color: var(--color-teal-dark);
	}

	.testimonial-date {
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.testimonial-card {
			width: clamp(200px, 78vw, 280px);
		}
	}
</style>
