---
import TestimonialAvatar from "./TestimonialAvatar.astro";
import { splitHighlighted } from "../utils/highlightText";
import type { TestimonialsContent } from "../types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Students"]);

function formatDate(iso: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

// Fixed decorative avatar tints tied to list position (not admin-editable
// data, and independent of gender, which only picks the silhouette shape),
// same positional-array convention as Pain Points'/Services' icon arrays.
const avatarTints = [
  { bg: "var(--color-primary-light)", fg: "var(--color-primary)" },
  { bg: "var(--color-secondary-light)", fg: "var(--color-secondary)" },
  { bg: "var(--color-tertiary-light)", fg: "var(--color-tertiary)" },
];
---

{content.items.length > 0 && (
	<section id="testimonials" class="testimonials">
		<div class="container">
			<div class="testimonials-heading">
				<h2>
					{titleParts.map((part) =>
						part.highlight ? (
							<span class="highlight">{part.text}</span>
						) : (
							<>{part.text}</>
						)
					)}
				</h2>
			</div>
			<div class="testimonials-carousel">
				<button type="button" class="testimonials-arrow testimonials-arrow--prev" aria-label="Previous review">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
				</button>
				<div class="testimonials-row" role="list">
					{content.items.map((item, i) => (
						<article class="testimonial-card" data-hover-lift role="listitem">
							<svg class="testimonial-quote" viewBox="0 0 24 16" width="34" height="24" fill="var(--color-primary)" aria-hidden="true">
								<path d="M7 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L9.5 7C7.8 7.8 7 8.9 7 10c1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
								<path d="M16 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L18.5 7c-1.7.8-2.5 1.9-2.5 3 1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
							</svg>
							<p class="testimonial-text">{item.text}</p>
							<button type="button" class="testimonial-toggle">Show more</button>
							<svg class="testimonial-divider" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
								<path d="M0,2 H50 L65,15 L80,2 H300" fill="none" stroke="var(--color-primary-dark)" stroke-width="1.5" />
							</svg>
							<footer class="testimonial-meta">
								<span class="testimonial-avatar-circle" style={`background: ${avatarTints[i % avatarTints.length].bg}; color: ${avatarTints[i % avatarTints.length].fg}`}>
									<TestimonialAvatar class="testimonial-avatar" gender={item.gender} />
								</span>
								<span class="testimonial-meta-text">
									<span class="testimonial-name">{item.name}</span>
									<time class="testimonial-date" datetime={item.date}>{formatDate(item.date)}</time>
								</span>
							</footer>
						</article>
					))}
				</div>
				<button type="button" class="testimonials-arrow testimonials-arrow--next" aria-label="Next review">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
				</button>
			</div>
			<div class="testimonials-dots" role="tablist" aria-label="Choose a review">
				{content.items.map((_, i) => (
					<button type="button" class="testimonials-dot" data-index={i} aria-label={`Show review ${i + 1}`}></button>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.testimonials {
		padding: var(--section-padding);
		background: var(--color-secondary-pale);
		overflow: hidden;
	}

	.testimonials-heading {
		text-align: center;
		margin-bottom: 2rem;
	}

	h2 {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
	}

	h2 .highlight {
		color: var(--color-tertiary);
	}

	.testimonials-carousel {
		position: relative;
	}

	.testimonials-arrow {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border: none;
		border-radius: var(--radius-full);
		background: var(--color-tertiary);
		box-shadow: var(--shadow-soft);
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	.testimonials-arrow:hover {
		transform: translateY(-50%) scale(1.08);
	}

	.testimonials-arrow--prev {
		left: -0.5rem;
	}

	.testimonials-arrow--next {
		right: -0.5rem;
	}

	.testimonials-row {
		display: flex;
		align-items: stretch;
		gap: 2rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		padding: 1rem 3.5rem 1.5rem;
		margin: 0 -0.25rem;
		scrollbar-width: none;
	}

	.testimonials-row::-webkit-scrollbar {
		display: none;
	}

	.testimonial-card {
		position: relative;
		display: flex;
		flex-direction: column;
		flex: 0 0 auto;
		scroll-snap-align: start;
		width: clamp(300px, 32vw, 380px);
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: 1.5rem 1.5rem 1.25rem;
		gap: 0.5rem;
	}

	.testimonial-quote {
		margin-bottom: 0.25rem;
	}

	.testimonial-text {
		color: var(--color-ink-soft);
		font-size: 0.9rem;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.testimonial-card.is-expanded .testimonial-text {
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.testimonial-toggle {
		align-self: flex-end;
		background: none;
		border: none;
		padding: 0;
		margin-bottom: 0.5rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--color-primary-dark);
		cursor: pointer;
	}

	.testimonial-divider {
		display: block;
		width: 100%;
		height: 0.9rem;
		margin-bottom: 0.75rem;
	}

	.testimonial-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.testimonial-avatar-circle {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-full);
	}

	:global(.testimonial-avatar) {
		width: 1.75rem;
		height: auto;
	}

	.testimonial-meta-text {
		display: flex;
		flex-direction: column;
	}

	.testimonial-name {
		font-weight: 700;
		color: var(--color-primary-dark);
	}

	.testimonial-date {
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		white-space: nowrap;
	}

	.testimonials-dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	.testimonials-dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: var(--radius-full);
		border: none;
		background: var(--color-white);
		box-shadow: inset 0 0 0 1.5px var(--color-primary-light);
		padding: 0;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.testimonials-dot.is-active {
		background: var(--color-tertiary);
		box-shadow: none;
	}

	@media (max-width: 560px) {
		.testimonial-card {
			width: clamp(260px, 82vw, 340px);
		}

		.testimonials-row {
			padding-inline: 3rem;
		}

		.testimonials-arrow {
			width: 2.5rem;
			height: 2.5rem;
		}
	}
</style>

<script>
	const row = document.querySelector<HTMLElement>(".testimonials-row");
	const cards = Array.from(document.querySelectorAll<HTMLElement>(".testimonial-card"));
	const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".testimonials-dot"));
	const prevBtn = document.querySelector<HTMLButtonElement>(".testimonials-arrow--prev");
	const nextBtn = document.querySelector<HTMLButtonElement>(".testimonials-arrow--next");

	cards.forEach((card) => {
		const text = card.querySelector<HTMLElement>(".testimonial-text");
		const toggle = card.querySelector<HTMLButtonElement>(".testimonial-toggle");
		if (!text || !toggle) return;

		if (text.scrollHeight <= text.clientHeight + 1) {
			toggle.hidden = true;
			return;
		}

		toggle.addEventListener("click", () => {
			const expanded = card.classList.toggle("is-expanded");
			toggle.textContent = expanded ? "Show less" : "Show more";
		});
	});

	if (row && cards.length > 0) {
		prevBtn?.addEventListener("click", () => {
			row.scrollBy({ left: -(cards[0].offsetWidth + 32), behavior: "smooth" });
		});
		nextBtn?.addEventListener("click", () => {
			row.scrollBy({ left: cards[0].offsetWidth + 32, behavior: "smooth" });
		});

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				const card = cards[i];
				if (!card) return;
				const delta = card.getBoundingClientRect().left - row.getBoundingClientRect().left;
				row.scrollBy({ left: delta, behavior: "smooth" });
			});
		});

		const setActive = (index: number) => {
			dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((entry) => entry.isIntersecting)
					.map((entry) => ({ index: cards.indexOf(entry.target as HTMLElement), ratio: entry.intersectionRatio }))
					.filter((entry) => entry.index !== -1);
				// Prefer the leftmost card that's (near enough) fully visible, rather
				// than strictly the highest ratio — sub-pixel rounding can otherwise
				// make an earlier card lose to a later one that's 100.0% vs 99.9%.
				const fullyVisible = visible.filter((entry) => entry.ratio >= 0.95);
				const pool = fullyVisible.length > 0 ? fullyVisible : visible;
				pool.sort((a, b) => a.index - b.index);
				if (pool.length > 0) setActive(pool[0].index);
			},
			{
				root: row,
				threshold: [0.5, 0.75, 1],
			}
		);

		cards.forEach((card) => observer.observe(card));
		setActive(0);
	}
</script>
