---
import TestimonialAvatar from "./TestimonialAvatar.astro";
import { splitHighlighted } from "../utils/highlightText";
import type { TestimonialsContent } from "../types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Students"]);

function formatDate(iso: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

// Fixed decorative avatar tints tied to list position (not admin-editable
// data, and independent of gender, which only picks the silhouette shape),
// same positional-array convention as Pain Points'/Services' icon arrays.
const avatarTints = [
  { bg: "var(--color-primary-light)", fg: "var(--color-primary)" },
  { bg: "var(--color-secondary-pale)", fg: "var(--color-secondary)" },
  { bg: "var(--color-tertiary-light)", fg: "var(--color-tertiary)" },
];
---

{content.items.length > 0 && (
	<section id="testimonials" class="testimonials">
		<div class="container">
			<div class="testimonials-heading">
				<h2>
					{titleParts.map((part) =>
						part.highlight ? (
							<span class="highlight">{part.text}</span>
						) : (
							<>{part.text}</>
						)
					)}
				</h2>
			</div>
			<div class="testimonials-carousel">
				<button type="button" class="testimonials-arrow testimonials-arrow--prev" aria-label="Previous review">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
				</button>
				<div class="testimonials-viewport">
					<div class="testimonials-row" role="list">
						{content.items.map((item, i) => (
							<article class="testimonial-card" role="listitem">
								<svg class="testimonial-quote" viewBox="0 0 24 16" width="34" height="24" fill="var(--color-primary)" aria-hidden="true">
									<path d="M7 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L9.5 7C7.8 7.8 7 8.9 7 10c1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
									<path d="M16 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L18.5 7c-1.7.8-2.5 1.9-2.5 3 1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
								</svg>
								<p class="testimonial-text">{item.text}</p>
								<button type="button" class="testimonial-toggle">Show more</button>
								<svg class="testimonial-divider" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
									<path d="M0,2 H50 L65,15 L80,2 H300" fill="none" stroke="var(--color-primary-dark)" stroke-width="1.5" />
								</svg>
								<footer class="testimonial-meta">
									<span class="testimonial-avatar-circle" style={`background: ${avatarTints[i % avatarTints.length].bg}; color: ${avatarTints[i % avatarTints.length].fg}`}>
										<TestimonialAvatar class="testimonial-avatar" gender={item.gender} />
									</span>
									<span class="testimonial-meta-text">
										<span class="testimonial-name">{item.name}</span>
										<time class="testimonial-date" datetime={item.date}>{formatDate(item.date)}</time>
									</span>
								</footer>
							</article>
						))}
					</div>
				</div>
				<button type="button" class="testimonials-arrow testimonials-arrow--next" aria-label="Next review">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
				</button>
			</div>
			<div class="testimonials-dots" role="tablist" aria-label="Choose a review">
				{content.items.map((_, i) => (
					<button type="button" class="testimonials-dot" data-index={i} aria-label={`Show review ${i + 1}`}></button>
				))}
			</div>
		</div>
		<div class="testimonial-modal-backdrop" id="testimonial-modal-backdrop" hidden>
			<div class="testimonial-modal-card" role="dialog" aria-modal="true" aria-label="Full review">
				<button type="button" class="testimonial-modal-close" aria-label="Close">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-primary-dark)" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
				</button>
				<svg class="testimonial-quote" viewBox="0 0 24 16" width="34" height="24" fill="var(--color-primary)" aria-hidden="true">
					<path d="M7 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L9.5 7C7.8 7.8 7 8.9 7 10c1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
					<path d="M16 15c-1.7 0-3-1.3-3-3 0-2.8 1.8-5.2 4.5-6.5L18.5 7c-1.7.8-2.5 1.9-2.5 3 1.7 0 3 1.3 3 3s-1.3 3-3 3z" />
				</svg>
				<p class="testimonial-modal-text"></p>
				<div class="testimonial-meta">
					<span class="testimonial-avatar-circle testimonial-modal-avatar"></span>
					<span class="testimonial-meta-text">
						<span class="testimonial-modal-name"></span>
						<span class="testimonial-modal-date"></span>
					</span>
				</div>
			</div>
		</div>
	</section>
)}

<style>
	.testimonials {
		padding: var(--section-padding);
		background: var(--color-secondary-pale);
		overflow: hidden;
		/* Fixed card metrics, shared by the row's centering padding, the
		   viewport's exactly-3-cards width, and the card size itself, so the
		   viewport always clips to precisely 3 cards with none peeking. */
		--tcard-w: clamp(220px, 26vw, 320px);
		--tcard-gap: 1.25rem;
	}

	.testimonials-heading {
		text-align: center;
		margin-bottom: 2rem;
	}

	h2 {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
	}

	h2 .highlight {
		color: var(--color-tertiary);
	}

	.testimonials-carousel {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.testimonials-viewport {
		width: calc(3 * var(--tcard-w) + 2 * var(--tcard-gap));
		max-width: 100%;
		/* Clip horizontally only — the center card's focus-scale grows past
		   its own layout box, and clipping vertically too would cut its top
		   and bottom off. */
		overflow-x: hidden;
		overflow-y: visible;
	}

	.testimonials-arrow {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border: none;
		border-radius: var(--radius-full);
		background: var(--color-tertiary);
		box-shadow: var(--shadow-soft);
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	.testimonials-arrow:hover {
		transform: translateY(-50%) scale(1.08);
	}

	.testimonials-arrow--prev {
		left: -2rem;
	}

	.testimonials-arrow--next {
		right: -2rem;
	}

	.testimonials-row {
		display: flex;
		align-items: center;
		gap: var(--tcard-gap);
		overflow-x: auto;
		scroll-snap-type: x proximity;
		/* Horizontal padding of exactly one card+gap on each side lets the
		   first and last real cards still scroll all the way to the
		   viewport's center. Vertical padding leaves room for the centered
		   card's focus-scale (up to 1.15x) to grow without visually
		   colliding with the heading/dots above and below. */
		padding: 2.75rem calc(var(--tcard-w) + var(--tcard-gap)) 3rem;
		scrollbar-width: none;
	}

	.testimonials-row::-webkit-scrollbar {
		display: none;
	}

	.testimonial-card {
		position: relative;
		display: flex;
		flex-direction: column;
		flex: 0 0 auto;
		scroll-snap-align: center;
		transform-origin: center;
		width: var(--tcard-w);
		height: 21rem;
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: 1.5rem 1.5rem 1.25rem;
		gap: 0.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.testimonial-card {
			transition: transform 0.2s ease, opacity 0.2s ease;
		}
	}

	.testimonial-quote {
		margin-bottom: 0.25rem;
		flex-shrink: 0;
	}

	.testimonial-text {
		color: var(--color-ink-soft);
		font-size: 0.9rem;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.testimonial-toggle {
		align-self: flex-end;
		background: none;
		border: none;
		padding: 0;
		margin-bottom: 0.5rem;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--color-primary-dark);
		cursor: pointer;
	}

	.testimonial-divider {
		display: block;
		width: 100%;
		height: 0.9rem;
		margin-top: auto;
		margin-bottom: 0.75rem;
		flex-shrink: 0;
	}

	.testimonial-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.testimonial-avatar-circle {
		position: relative;
		flex-shrink: 0;
		overflow: hidden;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-full);
	}

	:global(.testimonial-avatar) {
		position: absolute;
		left: 50%;
		bottom: 0;
		translate: -50% 0;
		width: 2.4rem;
		height: auto;
	}

	.testimonial-meta-text {
		display: flex;
		flex-direction: column;
	}

	.testimonial-name {
		font-weight: 700;
		color: var(--color-primary-dark);
	}

	.testimonial-date {
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		white-space: nowrap;
	}

	.testimonials-dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	.testimonials-dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: var(--radius-full);
		border: none;
		background: var(--color-white);
		box-shadow: inset 0 0 0 1.5px var(--color-primary-light);
		padding: 0;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.testimonials-dot.is-active {
		background: var(--color-tertiary);
		box-shadow: none;
	}

	@media (max-width: 700px) {
		.testimonials {
			--tcard-w: clamp(150px, 27vw, 210px);
			--tcard-gap: 0.75rem;
		}

		.testimonial-card {
			height: 19rem;
			padding: 1.1rem 1.1rem 1rem;
		}

		.testimonial-text {
			font-size: 0.8rem;
			-webkit-line-clamp: 4;
		}

		.testimonials-arrow {
			width: 2.5rem;
			height: 2.5rem;
		}

		.testimonials-arrow--prev {
			left: -1rem;
		}

		.testimonials-arrow--next {
			right: -1rem;
		}
	}

	.testimonial-modal-backdrop {
		position: fixed;
		inset: 0;
		z-index: 100;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		background: color-mix(in srgb, var(--color-primary-dark) 55%, transparent);
	}

	.testimonial-modal-backdrop:not([hidden]) {
		display: flex;
	}

	.testimonial-modal-card {
		position: relative;
		width: min(34rem, 100%);
		max-height: 80vh;
		overflow-y: auto;
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-lift);
		padding: 2rem 1.75rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.testimonial-modal-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: none;
		border-radius: var(--radius-full);
		background: var(--color-cream);
		cursor: pointer;
	}

	.testimonial-modal-text {
		color: var(--color-ink-soft);
		white-space: pre-line;
	}
</style>

<script>
	const row = document.querySelector<HTMLElement>(".testimonials-row");
	const cards = Array.from(document.querySelectorAll<HTMLElement>(".testimonial-card"));
	const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".testimonials-dot"));
	const prevBtn = document.querySelector<HTMLButtonElement>(".testimonials-arrow--prev");
	const nextBtn = document.querySelector<HTMLButtonElement>(".testimonials-arrow--next");

	const modalBackdrop = document.getElementById("testimonial-modal-backdrop");
	const modalText = modalBackdrop?.querySelector<HTMLElement>(".testimonial-modal-text");
	const modalAvatar = modalBackdrop?.querySelector<HTMLElement>(".testimonial-modal-avatar");
	const modalName = modalBackdrop?.querySelector<HTMLElement>(".testimonial-modal-name");
	const modalDate = modalBackdrop?.querySelector<HTMLElement>(".testimonial-modal-date");
	const modalClose = modalBackdrop?.querySelector<HTMLButtonElement>(".testimonial-modal-close");

	function openModal(card: HTMLElement) {
		if (!modalBackdrop || !modalText || !modalAvatar || !modalName || !modalDate) return;
		modalText.textContent = card.querySelector(".testimonial-text")?.textContent ?? "";
		const avatarCircle = card.querySelector<HTMLElement>(".testimonial-avatar-circle");
		modalAvatar.innerHTML = avatarCircle?.innerHTML ?? "";
		modalAvatar.setAttribute("style", avatarCircle?.getAttribute("style") ?? "");
		modalName.textContent = card.querySelector(".testimonial-name")?.textContent ?? "";
		modalDate.textContent = card.querySelector(".testimonial-date")?.textContent ?? "";
		modalBackdrop.hidden = false;
	}

	function closeModal() {
		if (modalBackdrop) modalBackdrop.hidden = true;
	}

	modalClose?.addEventListener("click", closeModal);
	modalBackdrop?.addEventListener("click", (event) => {
		if (event.target === modalBackdrop) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && modalBackdrop && !modalBackdrop.hidden) closeModal();
	});

	cards.forEach((card) => {
		const text = card.querySelector<HTMLElement>(".testimonial-text");
		const toggle = card.querySelector<HTMLButtonElement>(".testimonial-toggle");
		if (!text || !toggle) return;

		if (text.scrollHeight <= text.clientHeight + 1) {
			toggle.hidden = true;
			return;
		}

		toggle.addEventListener("click", () => openModal(card));
	});

	if (row && cards.length > 0 && dots.length > 0) {
		function centerCard(card: HTMLElement, behavior: ScrollBehavior) {
			const rowRect = row!.getBoundingClientRect();
			const cardRect = card.getBoundingClientRect();
			const delta = cardRect.left + cardRect.width / 2 - (rowRect.left + rowRect.width / 2);
			row!.scrollBy({ left: delta, behavior });
		}

		function closestIndex(): number {
			const rowRect = row!.getBoundingClientRect();
			const rowCenter = rowRect.left + rowRect.width / 2;
			let closest = 0;
			let minDist = Infinity;
			cards.forEach((card, i) => {
				const rect = card.getBoundingClientRect();
				const dist = Math.abs(rect.left + rect.width / 2 - rowCenter);
				if (dist < minDist) {
					minDist = dist;
					closest = i;
				}
			});
			return closest;
		}

		function setActive(index: number) {
			dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
		}

		function applyScale() {
			const rowRect = row!.getBoundingClientRect();
			const rowCenter = rowRect.left + rowRect.width / 2;
			const half = rowRect.width / 2 || 1;
			cards.forEach((card) => {
				const rect = card.getBoundingClientRect();
				const dist = Math.abs(rect.left + rect.width / 2 - rowCenter);
				const t = Math.min(dist / half, 1);
				card.style.transform = `scale(${(1.15 - t * 0.33).toFixed(3)})`;
				card.style.opacity = (1 - t * 0.4).toFixed(3);
			});
		}

		let ticking = false;
		function onScrollTick() {
			applyScale();
			setActive(closestIndex());
			ticking = false;
		}

		row.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(onScrollTick);
				}
			},
			{ passive: true }
		);

		prevBtn?.addEventListener("click", () => {
			const idx = closestIndex();
			centerCard(cards[Math.max(idx - 1, 0)], "smooth");
		});
		nextBtn?.addEventListener("click", () => {
			const idx = closestIndex();
			centerCard(cards[Math.min(idx + 1, cards.length - 1)], "smooth");
		});

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				const card = cards[i];
				if (card) centerCard(card, "smooth");
			});
		});

		window.addEventListener("resize", () => {
			const active = dots.findIndex((dot) => dot.classList.contains("is-active"));
			applyScale();
			if (active >= 0) centerCard(cards[active], "auto");
		});

		requestAnimationFrame(() => {
			const initialIndex = cards.length > 1 ? 1 : 0;
			centerCard(cards[initialIndex], "auto");
			applyScale();
			setActive(initialIndex);
		});
	}
</script>
