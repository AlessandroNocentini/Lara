---
import { withBase } from "../utils/baseUrl";
import SectionKicker from "./SectionKicker.astro";
import type { TestimonialsContent } from "../types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;

const AVATARS: Record<string, string> = {
  male: "/images/testimonial_male.svg",
  female: "/images/testimonial_female.svg",
  other: "/images/testimonial_other.svg",
};

function formatDate(iso: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

{content.items.length > 0 && (
	<section id="testimonials" class="testimonials">
		<div class="container">
			<div class="testimonials-heading">
				<SectionKicker label="Reviews" color="var(--color-red)" />
				<h2>{content.title}</h2>
			</div>
			<div class="testimonials-row" role="list">
				{content.items.map((item) => (
					<article class="testimonial-card" data-hover-lift role="listitem">
						<img
							class="testimonial-avatar"
							src={withBase(AVATARS[item.gender] ?? AVATARS.other)}
							alt=""
							aria-hidden="true"
							loading="lazy"
						/>
						<div class="testimonial-bubble">
							<p class="testimonial-text">{item.text}</p>
							<button type="button" class="testimonial-toggle">Read more</button>
							<footer class="testimonial-meta">
								<span class="testimonial-name">{item.name}</span>
								<time class="testimonial-date" datetime={item.date}>{formatDate(item.date)}</time>
							</footer>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.testimonials {
		padding: var(--section-padding);
		background: var(--color-cream);
		overflow: hidden;
	}

	.testimonials-heading {
		text-align: center;
		margin-bottom: 2rem;
	}

	h2 {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		color: var(--color-teal-dark);
	}

	.testimonials-row {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		padding: 1rem 0.25rem 1.5rem;
		margin: 0 -0.25rem;
		scrollbar-width: thin;
		scrollbar-color: var(--color-teal) transparent;
	}

	.testimonial-card {
		position: relative;
		display: flex;
		align-items: flex-start;
		flex: 0 0 auto;
		scroll-snap-align: start;
		width: clamp(416px, 54vw, 512px);
	}

	.testimonial-avatar {
		position: relative;
		z-index: 1;
		width: 4.5rem;
		height: auto;
		flex-shrink: 0;
		margin-top: 0.75rem;
		margin-right: -1rem;
		filter: drop-shadow(0 4px 6px rgb(15 118 110 / 0.2));
	}

	.testimonial-bubble {
		position: relative;
		flex: 1;
		min-width: 0;
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: 1.25rem 1.25rem 1rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		min-height: 9rem;
	}

	.testimonial-bubble::before {
		content: "";
		position: absolute;
		left: 1.75rem;
		bottom: -0.7rem;
		width: 0;
		height: 0;
		border-left: 0.7rem solid transparent;
		border-right: 0.7rem solid transparent;
		border-top: 0.7rem solid var(--color-white);
	}

	.testimonial-text {
		color: var(--color-ink-soft);
		font-size: 0.9rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.testimonial-card.is-expanded .testimonial-text {
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.testimonial-toggle {
		align-self: flex-start;
		background: none;
		border: none;
		padding: 0;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--color-teal-dark);
		text-decoration: underline;
		cursor: pointer;
	}

	.testimonial-meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		border-top: 1px solid rgb(15 118 110 / 0.12);
		padding-top: 0.6rem;
	}

	.testimonial-name {
		font-weight: 700;
		color: var(--color-teal-dark);
	}

	.testimonial-date {
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.testimonial-card {
			width: clamp(320px, 90vw, 400px);
		}

		.testimonial-avatar {
			width: 3.5rem;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>(".testimonial-card").forEach((card) => {
		const text = card.querySelector<HTMLElement>(".testimonial-text");
		const toggle = card.querySelector<HTMLButtonElement>(".testimonial-toggle");
		if (!text || !toggle) return;

		if (text.scrollHeight <= text.clientHeight + 1) {
			toggle.hidden = true;
			return;
		}

		toggle.addEventListener("click", () => {
			const expanded = card.classList.toggle("is-expanded");
			toggle.textContent = expanded ? "Show less" : "Read more";
		});
	});
</script>
