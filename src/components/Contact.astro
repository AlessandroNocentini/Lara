---
import SocialIcon from "./SocialIcon.astro";
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { ContactContent, SocialLink } from "../types/content";

interface Props {
  content: ContactContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.heading, ["Touch"]);

const socialColors: Record<string, string> = {
  instagram: "var(--color-tertiary)",
  email: "var(--color-primary)",
};

function socialHandle(link: SocialLink): string {
  if (link.platform === "email") return link.url.replace(/^mailto:/, "");
  try {
    const segment = new URL(link.url).pathname.split("/").filter(Boolean)[0];
    return segment ? `@${segment}` : link.url;
  } catch {
    return link.url;
  }
}
---

<section id="contact" class="contact">
	<div class="container contact-inner">
		<div class="contact-form-card">
			<form class="contact-form" data-contact-form>
				<label>
					Your name
					<input type="text" name="name" required />
				</label>
				<label>
					Your email
					<input type="email" name="email" required />
				</label>
				<label>
					Subject
					<input type="text" name="subject" />
				</label>
				<label>
					Your message
					<textarea name="message" rows="4" required></textarea>
				</label>
				<button type="submit" class="button button-primary" data-hover-lift>
					Send message
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
				</button>
				<p class="success-message" data-success-message role="status">{content.successMessage}</p>
			</form>
		</div>

		<div class="contact-copy">
			<h2 class="contact-title">
				{titleParts.map((part) =>
					part.highlight ? (
						<span class="highlight-wrap">
							<span class="highlight">{part.text}</span>
							<span
								class="contact-star-stamp"
								aria-hidden="true"
								style={`mask-image:url(${withBase("/images/star_stamp.svg")});-webkit-mask-image:url(${withBase("/images/star_stamp.svg")});`}
							></span>
						</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			{content.description && <p class="description">{content.description}</p>}

			{content.socialLinks.length > 0 && (
				<div class="contact-connect">
					<p class="connect-label">{content.connectLabel}</p>
					<ul class="contact-social-list">
						{content.socialLinks.map((social) => (
							<li>
								<a
									href={social.url}
									class="contact-social-link"
									target={social.platform === "email" ? undefined : "_blank"}
									rel={social.platform === "email" ? undefined : "noopener noreferrer"}
								>
									<span class="contact-social-icon" style={`background: ${socialColors[social.platform] ?? "var(--color-primary)"}`}>
										<SocialIcon platform={social.platform} />
									</span>
									<span class="contact-social-text">
										<span class="contact-social-platform">{social.platform.charAt(0).toUpperCase() + social.platform.slice(1)}</span>
										<span class="contact-social-handle">{socialHandle(social)}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		<span
			class="contact-italy"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/italy.svg")});-webkit-mask-image:url(${withBase("/images/italy.svg")});`}
		></span>
	</div>
</section>

<style>
	.contact {
		position: relative;
		padding: var(--section-padding);
		background: var(--color-secondary-pale);
		overflow: hidden;
	}

	.contact-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.contact-form-card {
		background: var(--color-white);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-soft);
		padding: clamp(1.5rem, 3vw, 2rem);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.contact-form label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--color-primary-dark);
	}

	.contact-form input,
	.contact-form textarea {
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.7rem 0.9rem;
		border-radius: var(--radius-sm);
		border: 2px solid var(--color-primary);
		resize: vertical;
		color: var(--color-ink);
	}

	.contact-form button {
		align-self: flex-start;
		margin-top: 0.25rem;
	}

	.success-message {
		display: none;
		font-weight: 700;
		color: var(--color-primary-dark);
	}

	.contact-form.is-submitted .success-message {
		display: block;
	}

	.contact-form.is-submitted label,
	.contact-form.is-submitted button {
		display: none;
	}

	.contact-title {
		position: relative;
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
		margin-bottom: 1rem;
	}

	.highlight-wrap {
		position: relative;
		display: inline-block;
	}

	.contact-title .highlight {
		color: var(--color-tertiary);
	}

	.contact-star-stamp {
		display: block;
		position: absolute;
		top: -0.5rem;
		right: -1.75rem;
		width: 1.5rem;
		aspect-ratio: 15.257332 / 19.88335;
		background-color: var(--color-tertiary);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		pointer-events: none;
	}

	.description {
		color: var(--color-ink);
		white-space: pre-line;
		margin-bottom: 1.75rem;
	}

	.connect-label {
		font-weight: 700;
		color: var(--color-primary-dark);
		margin-bottom: 1rem;
	}

	.contact-social-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-social-link {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		text-decoration: none;
	}

	.contact-social-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-full);
		color: var(--color-white);
	}

	.contact-social-text {
		display: flex;
		flex-direction: column;
	}

	.contact-social-platform {
		font-weight: 700;
		color: var(--color-primary-dark);
	}

	.contact-social-handle {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
	}

	.contact-italy {
		display: block;
		position: absolute;
		right: 0;
		bottom: -1rem;
		width: 10rem;
		aspect-ratio: 287.9 / 346.2;
		background-color: var(--color-tertiary-light);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.6;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.contact-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.contact-form-card {
			order: 1;
		}

		.contact-copy {
			order: 2;
		}

		.contact-social-link {
			justify-content: center;
		}

		.contact-italy {
			right: 1rem;
			opacity: 0.4;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			form.classList.add("is-submitted");
		});
	});
</script>
