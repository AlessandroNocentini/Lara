---
import PlaceholderImage from "./PlaceholderImage.astro";
import { splitHighlighted } from "../utils/highlightText";
import type { MethodContent } from "../types/content";

interface Props {
  content: MethodContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Method"]);
---

<section id="method" class="method">
	<div class="container">
		<h2 class="method-title">
			{titleParts.map((part) =>
				part.highlight ? (
					<span class="highlight">{part.text}</span>
				) : (
					<>{part.text}</>
				)
			)}
		</h2>

		<div class="method-stage">
			{content.items.slice(0, 2).map((item) => (
				<article class="method-card polaroid" data-hover-lift>
					<PlaceholderImage src={item.image || undefined} alt={item.title} variant="square" />
					<p class="method-card-caption">{item.title}</p>
					<p class="method-card-description">{item.description}</p>
				</article>
			))}
			<p class="method-center-text">{content.introSubtitle}</p>
			{content.items.slice(2, 4).map((item) => (
				<article class="method-card polaroid" data-hover-lift>
					<PlaceholderImage src={item.image || undefined} alt={item.title} variant="square" />
					<p class="method-card-caption">{item.title}</p>
					<p class="method-card-description">{item.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.method {
		background: var(--color-secondary-pale);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.method-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		text-align: center;
		color: var(--color-primary-dark);
		margin-bottom: 3rem;
	}

	.method-title .highlight {
		color: var(--color-tertiary);
	}

	.method-stage {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 6vw, 4rem);
		max-width: 35rem;
		margin-inline: auto;
		align-items: start;
	}

	.polaroid {
		background: var(--color-white);
		padding: 0.75rem 0.75rem 2.75rem;
		box-shadow: var(--shadow-lift);
		rotate: -3deg;
	}

	.method-card:nth-child(2n) {
		rotate: 3deg;
	}

	.polaroid :global(.placeholder-image) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.method-card-caption {
		text-align: center;
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-primary-dark);
		margin-top: 0.75rem;
	}

	.method-card-description {
		text-align: center;
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		margin-top: 0.25rem;
	}

	.method-center-text {
		grid-column: 1 / -1;
		align-self: center;
		max-width: 22rem;
		margin-inline: auto;
		text-align: center;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-primary-dark);
	}

	@media (max-width: 800px) {
		.method-stage {
			grid-template-columns: 1fr;
			max-width: 20rem;
			gap: 2.5rem;
		}

		.method-center-text {
			max-width: none;
			margin-block: 0.5rem;
		}
	}
</style>
