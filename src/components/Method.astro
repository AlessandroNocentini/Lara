---
import PlaceholderImage from "./PlaceholderImage.astro";
import { splitHighlighted } from "../utils/highlightText";
import type { MethodContent } from "../types/content";

interface Props {
  content: MethodContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Method"]);
---

<section id="method" class="method">
	<div class="container method-top">
		<div class="method-copy">
			<h2 class="method-title">
				{titleParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<p class="method-subtitle">{content.introSubtitle}</p>
			<p class="method-intro-text">{content.introText}</p>
		</div>
		<div class="method-portrait">
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="circle" />
		</div>
	</div>

	<div class="container method-grid">
		{content.items.map((item) => (
			<article class="method-card" data-hover-lift>
				<div class="method-card-media">
					<PlaceholderImage src={item.image || undefined} alt={item.title} variant="rounded" />
				</div>
				<div class="method-card-body">
					<h3>{item.title}</h3>
					<p>{item.description}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.method {
		background: var(--color-secondary-pale);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.method-top {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.method-copy {
		display: flex;
		flex-direction: column;
		padding-top: 0.5rem;
	}

	.method-title {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 600;
		color: var(--color-primary-dark);
		margin-bottom: 1.25rem;
	}

	.method-title .highlight {
		color: var(--color-tertiary);
	}

	.method-subtitle {
		font-weight: 700;
		font-size: 1.2rem;
		color: var(--color-primary-dark);
		margin-bottom: 1rem;
	}

	.method-intro-text {
		color: var(--color-ink);
		max-width: 30rem;
	}

	.method-portrait {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 26rem;
		margin-left: auto;
	}

	.method-grid {
		position: relative;
		z-index: 1;
		margin-top: -6rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}

	@media (max-width: 900px) {
		.method-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 800px) {
		.method-top {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.method-copy {
			align-items: center;
			padding-top: 0;
		}

		.method-intro-text {
			max-width: none;
		}

		.method-portrait {
			max-width: 18rem;
			margin-inline: auto;
		}

		.method-grid {
			margin-top: 3rem;
		}
	}

	@media (max-width: 560px) {
		.method-grid {
			grid-template-columns: 1fr;
		}
	}

	.method-card {
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.method-card-media {
		flex: 1 1 50%;
		aspect-ratio: 4 / 3;
	}

	.method-card-media :global(.placeholder-image) {
		border-radius: 0;
	}

	.method-card-body {
		flex: 1 1 50%;
		padding: 1.5rem;
		text-align: center;
	}

	.method-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
		color: var(--color-primary-dark);
	}

	.method-card p {
		color: var(--color-ink-soft);
		font-size: 0.95rem;
	}
</style>
