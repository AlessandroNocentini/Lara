---
import PlaceholderImage from "./PlaceholderImage.astro";
import type { MethodContent } from "../types/content";

interface Props {
  content: MethodContent;
}

const { content } = Astro.props;
const rotations = [-2, 1, -1.5, 2, -1, 1.5];
---

<section id="method" class="method">
	<div class="method-intro-block">
		<div class="container method-intro-inner">
			<div class="method-intro-copy">
				<h2 class="method-title">{content.title}</h2>
				<p class="method-subtitle">{content.introSubtitle}</p>
				<p class="method-intro-text">{content.introText}</p>
				<p class="method-steps-label">{content.stepsLabel}:</p>
			</div>
			<div class="method-steps-col">
				<ul class="method-steps">
					{content.steps.map((step, i) => (
						<li
							class="method-step"
							data-hover-wiggle
							style={`--rotate: ${rotations[i % rotations.length]}deg`}
						>
							<span class="method-step-number">{i + 1}.</span> {step}
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="method-lessons-block">
		<div class="container">
			<h3 class="method-lessons-subtitle">{content.lessonsSubtitle}</h3>
			<div class="method-grid">
				{content.items.map((item) => (
					<article class="method-card" data-hover-lift>
						<div class="method-card-media">
							<PlaceholderImage src={item.image || undefined} alt={item.title} variant="rounded" />
						</div>
						<div class="method-card-body">
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.method-intro-block {
		background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
		color: var(--color-white);
		padding: var(--section-padding);
	}

	.method-intro-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.method-intro-copy {
		display: flex;
		flex-direction: column;
	}

	.method-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		margin-bottom: 0.75rem;
	}

	.method-subtitle {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-secondary-light);
		margin-bottom: 1rem;
	}

	.method-intro-text {
		color: rgb(255 255 255 / 0.85);
		max-width: 34rem;
		margin-bottom: 1.5rem;
	}

	.method-steps-col {
		display: flex;
		flex-direction: column;
	}

	.method-steps-label {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.85rem;
		color: var(--color-secondary-light);
	}

	.method-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.method-step {
		position: relative;
		max-width: 22rem;
		background: var(--color-cream);
		border: 2px solid var(--color-white);
		color: var(--color-primary-dark);
		border-radius: var(--radius-lg);
		padding: 1rem 1.5rem;
		font-weight: 700;
		font-size: 0.95rem;
		box-shadow: var(--shadow-soft);
		transform: rotate(var(--rotate));
	}

	.method-step-number {
		color: var(--color-primary);
	}

	.method-step::after {
		content: "";
		position: absolute;
		bottom: -0.55rem;
		left: 1.6rem;
		width: 1rem;
		height: 1rem;
		background: var(--color-cream);
		border-bottom: 2px solid var(--color-white);
		border-right: 2px solid var(--color-white);
		transform: rotate(45deg);
		border-radius: 0 0 3px 0;
	}

	@media (max-width: 800px) {
		.method-intro-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.method-intro-copy {
			align-items: center;
		}

		.method-intro-text {
			max-width: none;
		}

		.method-steps-col {
			align-items: center;
		}

		.method-steps {
			align-items: center;
		}
	}

	.method-lessons-block {
		background: var(--color-white);
		padding: var(--section-padding);
	}

	.method-lessons-subtitle {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		color: var(--color-primary-dark);
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.method-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}

	@media (max-width: 900px) {
		.method-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.method-grid {
			grid-template-columns: 1fr;
		}
	}

	.method-card {
		display: flex;
		flex-direction: column;
		background: var(--color-cream);
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.method-card-media {
		flex: 1 1 50%;
		aspect-ratio: 4 / 3;
	}

	.method-card-media :global(.placeholder-image) {
		border-radius: 0;
	}

	.method-card-body {
		flex: 1 1 50%;
		padding: 1.5rem;
	}

	.method-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
		color: var(--color-primary-dark);
	}

	.method-card p {
		color: var(--color-ink-soft);
		font-size: 0.95rem;
	}
</style>
