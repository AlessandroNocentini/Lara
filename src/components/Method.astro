---
import PlaceholderImage from "./PlaceholderImage.astro";
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { MethodContent } from "../types/content";

interface Props {
  content: MethodContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Method"]);
const teachParts = splitHighlighted(content.lessonsSubtitle, ["teach"]);
const timelineParts = splitHighlighted(content.stepsLabel, ["different"]);

// Fixed decorative icons + circle colors tied to timeline position (not
// admin-editable data), same positional-array convention as Pain Points'
// questionIcons.
const timelineIcons = [
  '<path d="M4 5h16v10H9l-4 4v-4H4z" />',
  '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />',
  '<path d="M4 9h2a2 2 0 1 1 0 4H4v4h4v-2a2 2 0 1 1 4 0v2h4v-4h2a2 2 0 1 0 0-4h-2V5h-4v2a2 2 0 1 1-4 0V5H4v4Z" />',
  '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />',
];
const timelineColors = ["var(--color-primary)", "var(--color-primary-dark)", "var(--color-secondary)", "var(--color-tertiary)"];
---

<section id="method" class="method">
	<div class="container method-top">
		<div class="method-copy">
			<h2 class="method-title">
				{titleParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<p class="method-subtitle">{content.introSubtitle}</p>
			<p class="method-intro-text">{content.introText}</p>
		</div>
		<div class="method-portrait">
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="circle" />
		</div>
	</div>

	<div class="container method-grid">
		{content.items.map((item) => (
			<article class="method-card" data-hover-lift>
				<div class="method-card-media">
					<PlaceholderImage src={item.image || undefined} alt={item.title} variant="rounded" />
				</div>
				<div class="method-card-body">
					<h3>{item.title}</h3>
					<p>{item.description}</p>
				</div>
			</article>
		))}
	</div>

	<div class="method-teach">
		<div class="method-teach-photo">
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="rounded" />
		</div>
		<div class="method-teach-copy">
			<div class="container method-teach-inner">
				<h3 class="method-teach-title">
					{teachParts.map((part) =>
						part.highlight ? (
							<span class="highlight">{part.text}</span>
						) : (
							<>{part.text}</>
						)
					)}
				</h3>
				<p class="method-teach-text">{content.teachingText}</p>
			</div>
			<span
				class="method-spritz-stamp"
				aria-hidden="true"
				style={`mask-image:url(${withBase("/images/spritz_stamp.svg")});-webkit-mask-image:url(${withBase("/images/spritz_stamp.svg")});`}
			></span>
		</div>
	</div>

	<div class="method-timeline-block">
		<div class="container">
			<h3 class="method-timeline-heading">
				{timelineParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h3>
			<div class="method-timeline">
				{content.steps.map((step, i) => (
					<div class="timeline-step">
						<span class="timeline-number">{`0${i + 1}`}</span>
						<span class="timeline-circle" style={`background: ${timelineColors[i % timelineColors.length]}`}>
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--color-white)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={timelineIcons[i % timelineIcons.length]} />
						</span>
						<h4 class="timeline-title">{step.title}</h4>
						<p class="timeline-description">{step.description}</p>
					</div>
				))}
			</div>
		</div>
		<span
			class="method-italy-stamp"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/italy_stamp.svg")});-webkit-mask-image:url(${withBase("/images/italy_stamp.svg")});`}
		></span>
	</div>
</section>

<style>
	.method {
		background: var(--color-secondary-pale);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.method-top {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.method-copy {
		display: flex;
		flex-direction: column;
		padding-top: 0.5rem;
	}

	.method-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
		margin-bottom: 1.25rem;
	}

	.method-title .highlight {
		color: var(--color-tertiary);
	}

	.method-subtitle {
		font-weight: 700;
		font-size: 1.2rem;
		color: var(--color-primary-dark);
		margin-bottom: 1rem;
	}

	.method-intro-text {
		color: var(--color-ink);
		max-width: 30rem;
	}

	.method-portrait {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 26rem;
		margin-left: auto;
	}

	.method-grid {
		position: relative;
		z-index: 2;
		margin-top: -6rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}

	@media (max-width: 900px) {
		.method-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 800px) {
		.method-top {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.method-copy {
			align-items: center;
			padding-top: 0;
		}

		.method-intro-text {
			max-width: none;
		}

		.method-portrait {
			max-width: 18rem;
			margin-inline: auto;
		}

		.method-grid {
			margin-top: 3rem;
		}
	}

	@media (max-width: 560px) {
		.method-grid {
			grid-template-columns: 1fr;
		}
	}

	.method-card {
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.method-card-media {
		flex: 1 1 50%;
		aspect-ratio: 4 / 3;
	}

	.method-card-media :global(.placeholder-image) {
		border-radius: 0;
	}

	.method-card-body {
		flex: 1 1 50%;
		padding: 1.5rem;
		text-align: center;
	}

	.method-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
		color: var(--color-primary-dark);
	}

	.method-card p {
		color: var(--color-ink-soft);
		font-size: 0.95rem;
	}

	/* Band A: "How I Teach" — full-bleed photo + primary-gradient copy,
	   same 2-column full-bleed pattern as Hero/About, same gradient formula
	   as Hero's own background. */
	.method-teach {
		display: grid;
		grid-template-columns: minmax(280px, 45%) 1fr;
		align-items: stretch;
		min-height: 32rem;
	}

	.method-teach-photo {
		position: relative;
		height: 100%;
	}

	.method-teach-photo :global(.placeholder-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.method-teach-copy {
		position: relative;
		background-color: var(--color-primary);
		background-image: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 88%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 94%, transparent) 100%);
		color: var(--color-white);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.method-teach-inner {
		padding-block: var(--section-padding);
	}

	.method-teach-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.05;
		margin-bottom: 1rem;
	}

	.method-teach-title .highlight {
		color: var(--color-secondary);
	}

	.method-teach-text {
		max-width: 28rem;
		color: rgb(255 255 255 / 0.85);
	}

	.method-spritz-stamp {
		display: block;
		position: absolute;
		right: clamp(1rem, 4vw, 2.5rem);
		bottom: 1rem;
		width: 3.5rem;
		aspect-ratio: 19.807003 / 49.121681;
		background-color: var(--color-white);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.9;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.method-teach {
			grid-template-columns: 1fr;
			min-height: auto;
			text-align: center;
		}

		.method-teach-photo {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
		}

		.method-teach-text {
			max-width: none;
			margin-inline: auto;
		}
	}

	/* Band B: 4-step icon timeline */
	.method-timeline-block {
		position: relative;
		background: var(--color-white);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.method-timeline-heading {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 600;
		text-align: center;
		color: var(--color-primary-dark);
		margin-bottom: 3.5rem;
	}

	.method-timeline-heading .highlight {
		color: var(--color-secondary);
	}

	.method-timeline {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}

	.method-timeline::before {
		content: "";
		position: absolute;
		top: 2.55rem;
		left: 12%;
		right: 12%;
		border-top: 2px dashed var(--color-primary-light);
		z-index: 0;
	}

	.timeline-step {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.timeline-number {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		margin-bottom: 0.5rem;
	}

	.timeline-circle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-soft);
		margin-bottom: 1.25rem;
	}

	.timeline-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-primary-dark);
		margin-bottom: 0.4rem;
	}

	.timeline-description {
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	.method-italy-stamp {
		display: block;
		position: absolute;
		right: 0;
		bottom: -1rem;
		width: 7rem;
		aspect-ratio: 45.914291 / 44.24184;
		background-color: var(--color-primary);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.85;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.method-timeline {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.method-timeline::before {
			display: none;
		}

		.method-italy-stamp {
			right: 1rem;
		}
	}
</style>
