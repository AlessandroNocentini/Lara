---
import PlaceholderImage from "./PlaceholderImage.astro";
import SocialIcon from "./SocialIcon.astro";
import SpritzTitle from "./SpritzTitle.astro";
import { withBase } from "../utils/baseUrl";
import type { HeroContent } from "../types/content";

interface Props {
  content: HeroContent;
  siteName: string;
  titleImage: string;
}

const { content, siteName, titleImage } = Astro.props;

const [firstLine, ...rest] = siteName.split(" with ");
const secondLine = rest.length > 0 ? `with ${rest.join(" with ")}` : "";
---

<section id="hero" class="hero">
	<svg class="hero-blob" viewBox="0 0 400 400" aria-hidden="true">
		<path
			fill="var(--color-secondary-light)"
			d="M300 70 C360 130 350 250 280 310 C210 370 90 360 50 290 C10 220 30 100 110 60 C190 20 240 10 300 70 Z"
		/>
	</svg>
	{content.socialLinks.length > 0 && (
		<ul class="social-links">
			{content.socialLinks.map((social) => (
				<li>
					<a
						href={social.url}
						data-hover-lift
						aria-label={social.platform}
						target={social.platform === "email" ? undefined : "_blank"}
						rel={social.platform === "email" ? undefined : "noopener noreferrer"}
					>
						<SocialIcon platform={social.platform} />
					</a>
				</li>
			))}
		</ul>
	)}
	<div class="hero-inner container">
		<div class="hero-copy">
			<span class="hero-italy" aria-hidden="true" style={`mask-image:url(${withBase("/images/italy.svg")});-webkit-mask-image:url(${withBase("/images/italy.svg")});`}></span>
			<h1>
				<span class="title-line">
					<SpritzTitle text={firstLine} image={titleImage} size="1.25em" gap="-0.08em" />
				</span>
				{secondLine && <span class="title-line">{secondLine}</span>}
			</h1>
			{content.text && <p class="hero-text">{content.text}</p>}
			<a class="button button-primary hero-cta" href="#contact" data-hover-lift>Let's learn together →</a>
		</div>
		<div class="hero-portrait" data-hover-lift>
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="square" />
		</div>
	</div>

	<svg class="hero-wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
		<path d="M0,50 C320,-20 1120,110 1440,40 L1440,100 L0,100 Z" fill="var(--color-cream)" />
	</svg>
</section>

<style>
	.hero {
		position: relative;
		background-color: var(--color-primary);
		background-image: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 88%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 94%, transparent) 100%);
		background-size: cover;
		background-position: center;
		color: var(--color-white);
		padding: calc(var(--navbar-height) + clamp(2.5rem, 6vw, 5rem)) clamp(1.5rem, 6vw, 4rem) 6rem;
		overflow: hidden;
	}

	.hero-blob {
		position: absolute;
		top: -10%;
		right: -8%;
		width: 26rem;
		height: 26rem;
		opacity: 0.12;
		pointer-events: none;
		z-index: 0;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.hero-copy {
		position: relative;
	}

	.hero-italy {
		display: block;
		position: absolute;
		left: -3.25rem;
		top: 0.25rem;
		width: 6rem;
		aspect-ratio: 287.9 / 346.2;
		background-color: var(--color-secondary-light);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.4;
		pointer-events: none;
		z-index: 0;
	}

	h1 {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		text-transform: uppercase;
		font-size: clamp(2.2rem, 4.2vw, 3.4rem);
		margin-bottom: 1.25rem;
	}

	.hero-text {
		position: relative;
		z-index: 1;
		white-space: pre-line;
		font-size: 1.1rem;
		line-height: 1.5;
		margin-bottom: 2rem;
		max-width: 26rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-blob {
			--enter-opacity: 0.12;
			animation: enter-fade-drift 1.1s ease-out both, idle-breathe 11s ease-in-out 1.1s infinite;
		}

		h1 {
			animation: enter-slide-left 0.5s ease-out 0.23s both;
		}

		.hero-text {
			animation: enter-fade-up 0.4s ease-out 0.32s both;
		}

		.hero-portrait {
			animation: enter-drop 0.7s cubic-bezier(0.34, 1.15, 0.64, 1) 0.15s both, idle-sway 9s ease-in-out 0.85s infinite;
		}

		.hero-cta {
			animation: enter-fade-up 0.4s ease-out 0.5s both;
		}

		.social-links {
			animation: enter-fade-up 0.4s ease-out 0.62s both;
		}
	}

	.title-line:last-child {
		text-transform: none;
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: 600;
		color: var(--color-secondary-light);
	}

	.social-links {
		position: absolute;
		top: calc(var(--navbar-height) + clamp(1rem, 3vw, 1.5rem));
		right: clamp(1.25rem, 4vw, 2rem);
		z-index: 2;
		list-style: none;
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-full);
		background: var(--color-white);
		color: var(--color-primary);
		box-shadow: var(--shadow-soft);
		transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.social-links a:hover {
		background: var(--color-tertiary);
		color: var(--color-white);
	}

	.hero-portrait {
		position: relative;
		width: min(420px, 78vw);
		margin-inline: auto;
	}

	.hero-portrait :global(.placeholder-image) {
		mask-image: linear-gradient(to left, black 55%, transparent 100%);
		-webkit-mask-image: linear-gradient(to left, black 55%, transparent 100%);
	}

	.hero-wave {
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 100%;
		height: 90px;
		display: block;
	}

	@media (max-width: 800px) {
		.hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.hero-italy {
			left: 50%;
			translate: -50% 0;
		}

		.hero-text {
			max-width: none;
			margin-inline: auto;
		}

		.hero-portrait :global(.placeholder-image) {
			mask-image: none;
			-webkit-mask-image: none;
		}
	}
</style>
