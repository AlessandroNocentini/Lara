---
import PlaceholderImage from "./PlaceholderImage.astro";
import SocialIcon from "./SocialIcon.astro";
import SpritzTitle from "./SpritzTitle.astro";
import { withBase } from "../utils/baseUrl";
import type { HeroContent } from "../types/content";

interface Props {
  content: HeroContent;
  siteName: string;
  titleImage: string;
}

const { content, siteName, titleImage } = Astro.props;

const [firstLine, ...rest] = siteName.split(" with ");
const secondLine = rest.length > 0 ? `with ${rest.join(" with ")}` : "";
---

<section id="hero" class="hero">
	<svg class="hero-blob" viewBox="0 0 400 400" aria-hidden="true">
		<path
			fill="var(--color-secondary-light)"
			d="M300 70 C360 130 350 250 280 310 C210 370 90 360 50 290 C10 220 30 100 110 60 C190 20 240 10 300 70 Z"
		/>
	</svg>
	{content.socialLinks.length > 0 && (
		<ul class="social-links">
			{content.socialLinks.map((social) => (
				<li>
					<a
						href={social.url}
						data-hover-lift
						data-platform={social.platform}
						aria-label={social.platform}
						target={social.platform === "email" ? undefined : "_blank"}
						rel={social.platform === "email" ? undefined : "noopener noreferrer"}
					>
						<SocialIcon platform={social.platform} />
					</a>
				</li>
			))}
		</ul>
	)}
	<div class="hero-inner">
		<div class="hero-copy container">
			<span class="hero-italy" aria-hidden="true" style={`mask-image:url(${withBase("/images/italy.svg")});-webkit-mask-image:url(${withBase("/images/italy.svg")});`}></span>
			<h1>
				<span class="title-line">
					<SpritzTitle text={firstLine} image={titleImage} size="1.25em" gap="-0.08em" />
				</span>
				{secondLine && <span class="title-line">{secondLine}</span>}
			</h1>
			{content.text && <p class="hero-text">{content.text}</p>}
			<a class="button button-primary hero-cta" href="#contact" data-hover-lift>Let's learn together →</a>
		</div>
		<div class="hero-portrait">
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="portrait" />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		background-color: var(--color-primary);
		background-image: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 88%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 94%, transparent) 100%);
		background-size: cover;
		background-position: center;
		color: var(--color-white);
		overflow: hidden;
	}

	.hero-blob {
		position: absolute;
		top: -10%;
		right: -8%;
		width: 26rem;
		height: 26rem;
		opacity: 0.12;
		pointer-events: none;
		z-index: 0;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(320px, 50%) 1fr;
		align-items: stretch;
		min-height: 34rem;
	}

	.hero-copy {
		position: relative;
		padding: calc(var(--navbar-height) + clamp(2.5rem, 6vw, 5rem)) clamp(1.5rem, 6vw, 4rem) clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 6vw, 4rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-italy {
		display: block;
		position: absolute;
		left: 3rem;
		top: calc(var(--navbar-height) + 10rem);
		width: 12rem;
		aspect-ratio: 287.9 / 346.2;
		background-color: var(--color-secondary-light);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.5;
		pointer-events: none;
		z-index: 0;
	}

	h1 {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-transform: uppercase;
		font-family: var(--font-display);
		letter-spacing: 0.015em;
		font-size: clamp(3.6rem, 7.5vw, 6.2rem);
		line-height: 1.05;
		margin-bottom: 1.25rem;
	}

	.hero-text {
		position: relative;
		z-index: 1;
		white-space: pre-line;
		font-size: 1.1rem;
		line-height: 1.5;
		margin-bottom: 2rem;
		max-width: 26rem;
	}

	.hero-cta {
		align-self: flex-start;
		padding: 0.65rem 1.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-blob {
			--enter-opacity: 0.12;
			animation: enter-fade-drift 1.1s ease-out both, idle-breathe 11s ease-in-out 1.1s infinite;
		}

		h1 {
			animation: enter-slide-left 0.5s ease-out 0.23s both;
		}

		.hero-text {
			animation: enter-fade-up 0.4s ease-out 0.32s both;
		}

		.hero-cta {
			animation: enter-fade-up 0.4s ease-out 0.5s both;
		}

		.social-links {
			animation: enter-fade-up 0.4s ease-out 0.62s both;
		}
	}

	.title-line:last-child {
		font-size: 0.65em;
		color: var(--color-secondary-light);
	}

	.social-links {
		position: absolute;
		top: calc(var(--navbar-height) + clamp(1rem, 3vw, 1.5rem));
		right: clamp(1.25rem, 4vw, 2rem);
		z-index: 2;
		list-style: none;
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius-full);
		background: var(--color-white);
		box-shadow: var(--shadow-soft);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.social-links :global(svg) {
		width: 28px;
		height: 28px;
	}

	.social-links a[data-platform="email"] {
		color: var(--color-primary);
	}

	.social-links a[data-platform="instagram"] {
		color: var(--color-tertiary);
	}

	.social-links a[data-platform="email"]:hover {
		background: var(--color-primary);
		color: var(--color-white);
	}

	.social-links a[data-platform="instagram"]:hover {
		background: var(--color-tertiary);
		color: var(--color-white);
	}

	.hero-portrait {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-portrait :global(.placeholder-image) {
		width: min(70%, 22rem);
		border-radius: 0;
		display: block;
		/* Sticker effect: a white outline that hugs the photo's own alpha
		   silhouette (a transparent-cutout PNG) rather than a rectangular
		   border. Each drop-shadow with 0 blur stamps a solid-white copy of
		   the image's shape offset in one direction; stacking a ring of them
		   around the image builds a continuous halo that follows the cutout
		   edge instead of a bounding box. */
		filter:
			drop-shadow(3px 0 0 white)
			drop-shadow(-3px 0 0 white)
			drop-shadow(0 3px 0 white)
			drop-shadow(0 -3px 0 white)
			drop-shadow(2.2px 2.2px 0 white)
			drop-shadow(-2.2px 2.2px 0 white)
			drop-shadow(2.2px -2.2px 0 white)
			drop-shadow(-2.2px -2.2px 0 white);
	}

	@media (max-width: 800px) {
		.hero-inner {
			grid-template-columns: 1fr;
			min-height: auto;
			text-align: center;
		}

		.hero-italy {
			left: 50%;
			translate: -50% 0;
		}

		.hero-text {
			max-width: none;
			margin-inline: auto;
		}

		.hero-portrait {
			height: auto;
			padding: 1.5rem 0;
		}

		.hero-portrait :global(.placeholder-image) {
			width: min(60%, 16rem);
		}
	}
</style>
