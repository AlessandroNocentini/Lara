---
import PlaceholderImage from "./PlaceholderImage.astro";
import { renderMarkdown } from "../utils/markdown";
import { withBase } from "../utils/baseUrl";
import type { AboutContent } from "../types/content";

interface Props {
  content: AboutContent;
}

const { content } = Astro.props;
const bioHtml = renderMarkdown(content.bio);
---

<section id="about" class="about">
	<div class="container about-copy">
		<div class="about-title-row">
			<h2 class="about-title">
				<span class="highlight">{content.greeting}</span> {content.name}
			</h2>
			<span
				class="about-stamp"
				aria-hidden="true"
				style={`mask-image:url(${withBase("/images/heart_stamp.svg")});-webkit-mask-image:url(${withBase("/images/heart_stamp.svg")});`}
			></span>
		</div>
		<div class="bio" set:html={bioHtml} />
	</div>
	<div class="about-photo" data-hover-lift>
		<div class="about-photo-frame polaroid">
			<PlaceholderImage src={content.image || undefined} alt={`Photo of ${content.name}`} variant="square" />
		</div>
	</div>
</section>

<style>
	.about {
		background-color: var(--color-primary);
		background-image: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 88%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 94%, transparent) 100%);
		display: grid;
		grid-template-columns: minmax(280px, 45%) 1fr;
		align-items: stretch;
		min-height: 40rem;
	}

	.about-photo {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.about-photo-frame {
		width: min(320px, 80%);
	}

	.polaroid {
		background: var(--color-white);
		padding: 0.75rem 0.75rem 2.25rem;
		box-shadow: var(--shadow-lift);
		rotate: -3deg;
	}

	.polaroid :global(.placeholder-image) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.about-copy {
		position: relative;
		padding: var(--section-padding);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.about-title-row {
		position: relative;
		margin-bottom: 1.25rem;
	}

	.about-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-white);
	}

	.about-title .highlight {
		color: var(--color-secondary);
	}

	.bio :global(p) {
		color: rgb(255 255 255 / 0.85);
		margin-bottom: 1rem;
	}

	.about-stamp {
		display: block;
		position: absolute;
		right: 10%;
		bottom: -1.5rem;
		width: 2.75rem;
		aspect-ratio: 13.4944 / 15.394346;
		background-color: var(--color-white);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.9;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.about {
			grid-template-columns: 1fr;
			min-height: auto;
			text-align: center;
		}

		.about-photo {
			width: 100%;
			height: auto;
			padding: 2rem 0;
		}

		.about-photo-frame {
			width: min(260px, 70%);
		}

		.about-copy {
			padding: var(--section-padding);
		}

		.about-stamp {
			right: 50%;
			translate: 50% 0;
		}
	}
</style>
