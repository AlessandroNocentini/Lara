---
import PlaceholderImage from "./PlaceholderImage.astro";
import { renderMarkdown } from "../utils/markdown";
import type { AboutContent } from "../types/content";

interface Props {
  content: AboutContent;
}

const { content } = Astro.props;
const bioHtml = renderMarkdown(content.bio);
---

<section id="about" class="about">
	<svg class="about-blob" viewBox="0 0 400 400" aria-hidden="true">
		<path
			fill="var(--color-primary)"
			d="M320 60 C380 110 390 220 330 290 C270 360 150 370 90 310 C30 250 30 130 100 70 C170 10 260 10 320 60 Z"
		/>
	</svg>
	<div class="about-inner">
		<div class="about-photo" data-hover-lift>
			<PlaceholderImage src={content.image || undefined} alt={`Photo of ${content.name}`} variant="rounded" />
		</div>
		<div class="container about-copy">
			<p class="greeting">{content.greeting}</p>
			<h2>{content.name}</h2>
			<div class="bio" set:html={bioHtml} />
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		background: var(--color-white);
		overflow: hidden;
	}

	.about-blob {
		position: absolute;
		top: -8%;
		right: -12%;
		width: 32rem;
		height: 32rem;
		opacity: 0.08;
		pointer-events: none;
		z-index: 0;
	}

	.about-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(280px, 45%) 1fr;
		align-items: stretch;
		min-height: 40rem;
	}

	.about-photo {
		position: relative;
		height: 100%;
	}

	.about-photo :global(.placeholder-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.about-copy {
		position: relative;
		padding: var(--section-padding);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.greeting {
		font-family: var(--font-heading);
		font-style: italic;
		font-size: 2rem;
		color: var(--color-tertiary);
	}

	h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		color: var(--color-primary-dark);
		margin-bottom: 1.25rem;
	}

	.bio :global(p) {
		color: var(--color-ink-soft);
		margin-bottom: 1rem;
	}

	@media (max-width: 800px) {
		.about-inner {
			grid-template-columns: 1fr;
			min-height: auto;
			text-align: center;
		}

		.about-photo {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 5;
		}

		.about-copy {
			padding: var(--section-padding);
		}
	}
</style>
