---
import NavIcon from "./NavIcon.astro";

const links = [
  { href: "#hero", id: "hero", label: "Home" },
  { href: "#pain-points", id: "pain-points", label: "Struggles" },
  { href: "#method", id: "method", label: "Method" },
  { href: "#services", id: "services", label: "Services" },
  { href: "#results", id: "results", label: "Results" },
  { href: "#testimonials", id: "testimonials", label: "Reviews" },
  { href: "#about", id: "about", label: "About" },
  { href: "#contact", id: "contact", label: "Contact" },
];
---

<nav class="navdock" aria-label="Section navigation">
	<ul class="navdock-list">
		{links.map((link) => (
			<li>
				<a href={link.href} class="navdock-item" data-section={link.id} data-hover-lift aria-label={link.label}>
					<span class="navdock-circle">
						<NavIcon section={link.id} />
					</span>
					<span class="navdock-tooltip">{link.label}</span>
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.navdock {
		position: fixed;
		top: 50%;
		left: clamp(0.75rem, 2vw, 1.5rem);
		translate: 0 -50%;
		z-index: 100;
	}

	.navdock-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
	}

	.navdock-item {
		position: relative;
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.navdock-circle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
		border-radius: var(--radius-full);
		background: var(--color-white);
		color: var(--color-teal);
		box-shadow: var(--shadow-soft);
		transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
	}

	.navdock-tooltip {
		position: absolute;
		left: calc(100% + 0.6rem);
		top: 50%;
		translate: -8px -50%;
		white-space: nowrap;
		background: var(--color-teal-dark);
		color: var(--color-white);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 0.35rem 0.85rem;
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-soft);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, translate 0.2s ease;
	}

	@media (hover: hover) {
		.navdock-item:hover .navdock-circle {
			background: var(--color-teal);
			color: var(--color-white);
		}

		.navdock-item:hover .navdock-tooltip {
			opacity: 1;
			translate: 0 -50%;
		}
	}

	.navdock-item.is-active .navdock-circle {
		background: var(--color-teal);
		color: var(--color-white);
		box-shadow: var(--shadow-soft), 0 0 0 3px rgb(15 118 110 / 0.25);
	}

	@media (max-width: 480px) {
		.navdock {
			left: 0.5rem;
		}

		.navdock-list {
			gap: 0.5rem;
		}

		.navdock-circle {
			width: 2.1rem;
			height: 2.1rem;
		}

		.navdock-circle :global(svg) {
			width: 16px;
			height: 16px;
		}

		.navdock-tooltip {
			font-size: 0.75rem;
			padding: 0.25rem 0.65rem;
		}
	}
</style>

<script>
	const sectionIds = ["hero", "pain-points", "method", "services", "results", "testimonials", "about", "contact"];
	const items = new Map<string, HTMLElement>();
	document.querySelectorAll<HTMLElement>(".navdock-item").forEach((el) => {
		const id = el.dataset.section;
		if (id) items.set(id, el);
	});

	const setActive = (id: string) => {
		items.forEach((el, key) => el.classList.toggle("is-active", key === id));
	};

	const observer = new IntersectionObserver(
		(entries) => {
			const visible = entries
				.filter((entry) => entry.isIntersecting)
				.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
			if (visible.length > 0) {
				const id = (visible[0].target as HTMLElement).id;
				setActive(id);
			}
		},
		{
			root: null,
			rootMargin: "-40% 0px -40% 0px",
			threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
		}
	);

	sectionIds.forEach((id) => {
		const section = document.getElementById(id);
		if (section) observer.observe(section);
	});
</script>
