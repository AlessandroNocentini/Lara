---
import SpritzTitle from "./SpritzTitle.astro";
import type { SiteMeta } from "../types/content";

interface Props {
  meta: SiteMeta;
}

const { meta } = Astro.props;

const [firstLine, ...rest] = meta.siteName.split(" with ");
const secondLine = rest.length > 0 ? `with ${rest.join(" with ")}` : "";

const links = [
  { href: "#hero", id: "hero", label: "Home" },
  { href: "#method", id: "method", label: "Method" },
  { href: "#services", id: "services", label: "Services" },
  { href: "#results", id: "results", label: "Results" },
  { href: "#about", id: "about", label: "About me" },
  { href: "#contact", id: "contact", label: "Contacts" },
];
const half = Math.ceil(links.length / 2);
const leftLinks = links.slice(0, half);
const rightLinks = links.slice(half);
---

<header class="navbar">
	<div class="navbar-inner container">
		<button
			id="navbar-toggle"
			class="navbar-toggle"
			type="button"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="navbar-links"
		>
			<span class="navbar-toggle-bar"></span>
			<span class="navbar-toggle-bar"></span>
			<span class="navbar-toggle-bar"></span>
		</button>

		<a href="#hero" class="navbar-logo" data-section="hero" aria-label="Home">
			<span class="navbar-logo-line">
				<SpritzTitle text={firstLine} image={meta.image} size="1.2em" gap="-0.05em" />
			</span>
			{secondLine && <span class="navbar-logo-line navbar-logo-line--accent">{secondLine}</span>}
		</a>

		<nav id="navbar-links" class="navbar-links" aria-label="Section navigation">
			<ul class="navbar-list navbar-list--left">
				{leftLinks.map((link) => (
					<li>
						<a href={link.href} class="navbar-item" data-section={link.id}>{link.label}</a>
					</li>
				))}
			</ul>
			<ul class="navbar-list navbar-list--right">
				{rightLinks.map((link) => (
					<li>
						<a href={link.href} class="navbar-item" data-section={link.id}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		height: var(--navbar-height);
		background: var(--color-white);
		box-shadow: var(--shadow-soft);
	}

	.navbar-inner {
		height: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		column-gap: clamp(1rem, 3vw, 2rem);
		padding-inline: clamp(1.25rem, 4vw, 2.5rem);
	}

	.navbar-links {
		display: contents;
	}

	.navbar-list--left {
		grid-row: 1;
		grid-column: 1;
		justify-self: end;
	}

	.navbar-logo {
		grid-row: 1;
		grid-column: 2;
		justify-self: center;
	}

	.navbar-list--right {
		grid-row: 1;
		grid-column: 3;
		justify-self: start;
	}

	.navbar-logo {
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1.2;
		text-decoration: none;
		color: var(--color-primary);
		font-family: var(--font-script);
		font-weight: 400;
		white-space: nowrap;
		translate: 0 0.2rem;
	}

	.navbar-logo-line {
		font-size: 1.4rem;
	}

	.navbar-logo-line--accent {
		font-size: 1.15rem;
		color: var(--color-secondary);
	}

	.navbar-list {
		list-style: none;
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 1.75rem);
		margin: 0;
		padding: 0;
	}

	.navbar-item {
		text-decoration: none;
		color: var(--color-ink);
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		transition: color 0.2s ease;
	}

	@media (hover: hover) {
		.navbar-item:hover {
			color: var(--color-primary);
		}
	}

	.navbar-item.is-active {
		color: var(--color-primary);
	}

	.navbar-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 0.3rem;
		width: 2.4rem;
		height: 2.4rem;
		border: none;
		background: none;
		cursor: pointer;
		padding: 0;
	}

	.navbar-toggle-bar {
		display: block;
		width: 100%;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		transition: translate 0.2s ease, rotate 0.2s ease, opacity 0.2s ease;
	}

	@media (max-width: 760px) {
		.navbar-toggle {
			display: flex;
		}

		.navbar-inner {
			grid-template-columns: auto 1fr auto;
		}

		.navbar-toggle {
			grid-column: 1;
		}

		.navbar-logo {
			grid-column: 2;
		}

		.navbar-links {
			display: block;
			position: fixed;
			top: var(--navbar-height);
			left: 0;
			right: 0;
			background: var(--color-white);
			box-shadow: var(--shadow-soft);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.navbar-list--left,
		.navbar-list--right {
			grid-column: auto;
			justify-self: auto;
		}

		.navbar-links.is-open {
			max-height: calc(100vh - var(--navbar-height));
			overflow-y: auto;
		}

		.navbar-list {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.navbar-item {
			display: block;
			padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
			border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
		}

		.navbar.is-open .navbar-toggle-bar:nth-child(1) {
			translate: 0 0.35rem;
			rotate: 45deg;
		}

		.navbar.is-open .navbar-toggle-bar:nth-child(2) {
			opacity: 0;
		}

		.navbar.is-open .navbar-toggle-bar:nth-child(3) {
			translate: 0 -0.35rem;
			rotate: -45deg;
		}
	}
</style>

<script>
	const navbar = document.querySelector<HTMLElement>(".navbar");
	const toggle = document.getElementById("navbar-toggle");
	const links = document.getElementById("navbar-links");

	const closeMenu = () => {
		navbar?.classList.remove("is-open");
		links?.classList.remove("is-open");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", () => {
		const isOpen = links?.classList.toggle("is-open");
		navbar?.classList.toggle("is-open", isOpen);
		toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
	});

	links?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

	document.addEventListener("click", (event) => {
		if (!navbar?.classList.contains("is-open")) return;
		if (event.target instanceof Node && !navbar.contains(event.target)) closeMenu();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMenu();
	});

	const items = new Map<string, HTMLElement>();
	document.querySelectorAll<HTMLElement>(".navbar-item[data-section]").forEach((el) => {
		const id = el.dataset.section;
		if (id) items.set(id, el);
	});

	const setActive = (id: string) => {
		items.forEach((el, key) => el.classList.toggle("is-active", key === id));
	};

	const observer = new IntersectionObserver(
		(entries) => {
			const visible = entries
				.filter((entry) => entry.isIntersecting)
				.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
			if (visible.length > 0) {
				const id = (visible[0].target as HTMLElement).id;
				setActive(id);
			}
		},
		{
			root: null,
			rootMargin: "-40% 0px -40% 0px",
			threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
		}
	);

	Array.from(items.keys()).forEach((id) => {
		const section = document.getElementById(id);
		if (section) observer.observe(section);
	});
</script>
