---
import PlaceholderImage from "./PlaceholderImage.astro";
import { renderMarkdown } from "../utils/markdown";
import type { ResultsContent } from "../types/content";

interface Props {
  content: ResultsContent;
}

const { content } = Astro.props;

const levels = ["beginner", "intermediate"] as const;

/** Splits a leading `**bold**` segment off a markdown string, using it as a
 *  plain-text title and rendering the remainder as markdown body. */
function splitLeadBold(markdown: string): { label: string; bodyHtml: string } {
  const match = markdown.match(/^\s*\*\*(.+?)\*\*\s*/);
  if (!match) return { label: "", bodyHtml: renderMarkdown(markdown) };
  return {
    label: match[1],
    bodyHtml: renderMarkdown(markdown.slice(match[0].length)),
  };
}

const activeLevels = levels
  .filter((key) => Boolean(content[key]))
  .map((key) => splitLeadBold(content[key]));
---

<section id="results" class="results">
	<svg class="results-blob" viewBox="0 0 400 400" aria-hidden="true">
		<path
			fill="var(--color-secondary)"
			d="M300 70 C360 130 350 250 280 310 C210 370 90 360 50 290 C10 220 30 100 110 60 C190 20 240 10 300 70 Z"
		/>
	</svg>
	<div class="container results-inner">
		<div class="results-image" data-hover-lift>
			<PlaceholderImage src={content.image || undefined} alt="Results of learning Italian with Lara" variant="rounded" />
		</div>
		<div class="results-levels">
			<h2>{content.title}</h2>
			{activeLevels.map((level) => (
				<div class="results-card" data-hover-lift>
					{level.label && <span class="results-label">{level.label}</span>}
					<div set:html={level.bodyHtml} />
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.results {
		position: relative;
		padding: var(--section-padding);
		background: var(--color-white);
		overflow: hidden;
	}

	.results-blob {
		position: absolute;
		bottom: -15%;
		left: -10%;
		width: 28rem;
		height: 28rem;
		opacity: 0.1;
		pointer-events: none;
		z-index: 0;
	}

	.results-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
	}

	.results-image :global(.placeholder-image) {
		height: auto;
		aspect-ratio: auto;
	}

	h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		color: var(--color-primary-dark);
		margin-bottom: 1.5rem;
	}

	.results-levels {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.results-card {
		background: var(--color-cream);
		border-left: 4px solid var(--color-secondary);
		border-radius: var(--radius-sm);
		padding: 1.25rem 1.5rem;
		box-shadow: var(--shadow-soft);
	}

	.results-label {
		display: inline-block;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-secondary);
		margin-bottom: 0.4rem;
	}

	.results-card :global(strong) {
		color: var(--color-primary-dark);
	}

	.results-card :global(p) {
		color: var(--color-ink-soft);
	}

	@media (max-width: 800px) {
		.results-inner {
			grid-template-columns: 1fr;
		}

		.results-image {
			max-width: 26rem;
			margin-inline: auto;
		}
	}
</style>
