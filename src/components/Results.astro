---
import PlaceholderImage from "./PlaceholderImage.astro";
import { renderMarkdown } from "../utils/markdown";
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { ResultsContent } from "../types/content";

interface Props {
  content: ResultsContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Achieve"]);

const levels = ["beginner", "intermediate"] as const;

/** Splits a leading `**bold**` segment off a markdown string, using it as a
 *  plain-text title and rendering the remainder as markdown body. */
function splitLeadBold(markdown: string): { label: string; bodyHtml: string } {
  const match = markdown.match(/^\s*\*\*(.+?)\*\*\s*/);
  if (!match) return { label: "", bodyHtml: renderMarkdown(markdown) };
  return {
    label: match[1],
    bodyHtml: renderMarkdown(markdown.slice(match[0].length)),
  };
}

const activeLevels = levels
  .filter((key) => Boolean(content[key]))
  .map((key) => splitLeadBold(content[key]));

// Fixed decorative icons + colors tied to card position (not admin-editable
// data), same positional-array convention as Pain Points'/Services' icon
// arrays. Both SVGs are already white-filled, so no mask-recolor needed.
const cardIcons = ["/images/results_plant.svg", "/images/results_tree.svg"];
const cardColors = ["var(--color-primary-light)", "var(--color-tertiary-light)"];
---

<section id="results" class="results">
	<svg class="results-blob" viewBox="0 0 400 400" aria-hidden="true">
		<path
			fill="var(--color-secondary)"
			d="M300 70 C360 130 350 250 280 310 C210 370 90 360 50 290 C10 220 30 100 110 60 C190 20 240 10 300 70 Z"
		/>
	</svg>
	<div class="container">
		<div class="results-top">
			<h2 class="results-title">
				{titleParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<div class="results-image" data-hover-lift>
				<PlaceholderImage src={content.image || undefined} alt="Results of learning Italian with Lara" variant="rounded" />
			</div>
		</div>
		<div class="results-cards">
			{activeLevels.map((level, i) => (
				<div class="results-card">
					<span class="results-card-icon" style={`background: ${cardColors[i % cardColors.length]}`}>
						<img src={withBase(cardIcons[i % cardIcons.length])} alt="" class="results-card-icon-img" />
					</span>
					<div class="results-card-body">
						{level.label && <p class="results-label">{level.label}</p>}
						<div set:html={level.bodyHtml} />
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.results {
		position: relative;
		padding: var(--section-padding);
		padding-top: clamp(1.5rem, 3vw, 3rem);
		background: var(--color-white);
		overflow: hidden;
	}

	.results-blob {
		position: absolute;
		bottom: -15%;
		left: -10%;
		width: 28rem;
		height: 28rem;
		opacity: 0.1;
		pointer-events: none;
		z-index: 0;
	}

	.results-top {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
		margin-bottom: 3rem;
	}

	.results-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
	}

	.results-title .highlight {
		color: var(--color-secondary);
	}

	.results-image :global(.placeholder-image) {
		height: auto;
		aspect-ratio: auto;
	}

	.results-cards {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.results-card {
		display: flex;
		align-items: stretch;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
	}

	.results-card-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 6.5rem;
	}

	.results-card-icon-img {
		width: 3.75rem;
		height: auto;
	}

	.results-card-body {
		flex: 1;
		background: var(--color-secondary-pale);
		padding: 1.5rem 2rem;
	}

	.results-label {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-primary-dark);
		margin-bottom: 0.35rem;
	}

	.results-card-body :global(p) {
		color: var(--color-ink-soft);
	}

	@media (max-width: 800px) {
		.results-top {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.results-image {
			max-width: 26rem;
			margin-inline: auto;
		}

		.results-card-icon {
			width: 5rem;
		}

		.results-card-body {
			padding: 1.25rem 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.results-card {
			flex-direction: column;
		}

		.results-card-icon {
			width: 100%;
			padding: 0.75rem;
		}
	}
</style>
