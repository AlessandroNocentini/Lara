---
import PlaceholderImage from "./PlaceholderImage.astro";
import { withBase } from "../utils/baseUrl";
import { splitHighlighted } from "../utils/highlightText";
import type { PainPointsContent } from "../types/content";

interface Props {
  content: PainPointsContent;
}

const { content } = Astro.props;

const headingParts = splitHighlighted(content.heading, content.highlightWords);

// Fixed decorative placement/color for each of the 4 scattered thoughts
// (not admin-editable data), same positional-array pattern this file
// previously used for the icon-circle list.
const thoughtStyles = [
  { top: "2%", left: "0%", rotate: "-6deg", color: "var(--color-primary-dark)" },
  { top: "6%", left: "62%", rotate: "5deg", color: "var(--color-tertiary)" },
  { top: "70%", left: "2%", rotate: "-4deg", color: "var(--color-secondary)" },
  { top: "68%", left: "60%", rotate: "7deg", color: "var(--color-primary)" },
];
---

<section id="pain-points" class="pain-points">
	<div class="container pain-points-inner">
		<h2>
			{headingParts.map((part) =>
				part.highlight ? (
					<span class="highlight">{part.text}</span>
				) : (
					<>{part.text}</>
				)
			)}
		</h2>
		<div class="pain-points-scatter">
			<div class="pain-points-photo polaroid" data-hover-lift>
				<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="square" />
			</div>
			{content.questions.map((question, i) => (
				<p
					class="pain-thought"
					style={`top:${thoughtStyles[i % thoughtStyles.length].top}; left:${thoughtStyles[i % thoughtStyles.length].left}; rotate:${thoughtStyles[i % thoughtStyles.length].rotate}; color:${thoughtStyles[i % thoughtStyles.length].color};`}
				>
					{question}
				</p>
			))}
		</div>
		<a class="button button-primary pain-points-cta" href={content.cta.target} data-hover-lift>{content.cta.label}</a>
		<span
			class="pain-points-stamp"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/italy_stamp.svg")});-webkit-mask-image:url(${withBase("/images/italy_stamp.svg")});`}
		></span>
	</div>
</section>

<style>
	.pain-points {
		position: relative;
		padding: var(--section-padding);
		background: var(--color-cream);
		overflow: hidden;
	}

	.pain-points-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		text-align: center;
	}

	h2 {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(1.5rem, 3.4vw, 3rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
		max-width: 60rem;
	}

	.highlight {
		color: var(--color-secondary);
	}

	.pain-points-scatter {
		position: relative;
		width: 100%;
		max-width: 46rem;
		min-height: 24rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.pain-points-photo {
		width: min(300px, 70%);
	}

	.polaroid {
		background: var(--color-white);
		padding: 0.75rem 0.75rem 2.25rem;
		box-shadow: var(--shadow-lift);
		rotate: -3deg;
	}

	.polaroid :global(.placeholder-image) {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	.pain-thought {
		position: absolute;
		max-width: 15rem;
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.3;
	}

	.pain-points-cta {
		align-self: center;
	}

	.pain-points-stamp {
		display: block;
		position: absolute;
		right: 0;
		bottom: -1rem;
		width: 7rem;
		aspect-ratio: 45.914291 / 44.24184;
		background-color: var(--color-primary-light);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.85;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.pain-points-scatter {
			flex-direction: column;
			min-height: auto;
			gap: 1.5rem;
		}

		.pain-thought {
			position: static;
			max-width: 22rem;
			rotate: 0deg !important;
		}

		.pain-points-stamp {
			right: 1rem;
		}
	}
</style>
