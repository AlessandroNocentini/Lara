---
import PlaceholderImage from "./PlaceholderImage.astro";
import { withBase } from "../utils/baseUrl";
import { splitHighlighted } from "../utils/highlightText";
import type { PainPointsContent } from "../types/content";

interface Props {
  content: PainPointsContent;
}

const { content } = Astro.props;

const headingParts = splitHighlighted(content.heading, content.highlightWords);

// Fixed decorative icons tied to list position (not admin-editable data),
// same positional-array pattern this file already used for card rotations.
const questionIcons = [
  '<path d="M6 18c3-1 5-4 4-7-1-2.5-4-2.5-4.5-.5-.5 2 1.5 3 3.5 2.5C12 12 13 8 11 6" />',
  '<rect x="5" y="9" width="14" height="10" rx="1.5" /><path d="M9 9V6.5A1.5 1.5 0 0 1 10.5 5h3A1.5 1.5 0 0 1 15 6.5V9" /><path d="M5 13.5h14" />',
  '<path d="M4 5h16v10H9l-4 4v-4H4z" />',
  '<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z" />',
];
---

<section id="pain-points" class="pain-points">
	<div class="container pain-points-inner">
		<div class="pain-points-portrait" data-hover-lift>
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="pill" />
		</div>
		<div class="pain-points-copy">
			<h2>
				{headingParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<ul class="pain-list">
				{content.questions.map((question, i) => (
					<li class="pain-item">
						<span class="pain-icon-circle" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--color-white)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={questionIcons[i % questionIcons.length]} />
						</span>
						<span class="pain-text">{question}</span>
					</li>
				))}
			</ul>
			<a class="button button-primary pain-points-cta" href={content.cta.target} data-hover-lift>{content.cta.label}</a>
		</div>
		<span
			class="pain-points-stamp"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/italy_stamp.svg")});-webkit-mask-image:url(${withBase("/images/italy_stamp.svg")});`}
		></span>
	</div>
</section>

<style>
	.pain-points {
		position: relative;
		padding: var(--section-padding);
		background: var(--color-cream);
		overflow: hidden;
	}

	.pain-points-inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
	}

	.pain-points-portrait {
		width: min(360px, 100%);
	}

	.pain-points-copy {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	h2 {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
	}

	.highlight {
		color: var(--color-secondary);
	}

	.pain-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.pain-item {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.pain-icon-circle {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-full);
		background: var(--color-primary-light);
	}

	.pain-text {
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--color-ink);
	}

	.pain-points-cta {
		align-self: flex-start;
	}

	.pain-points-stamp {
		display: block;
		position: absolute;
		right: 0;
		bottom: -1rem;
		width: 7rem;
		aspect-ratio: 45.914291 / 44.24184;
		background-color: var(--color-primary-light);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.85;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 800px) {
		.pain-points-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.pain-points-portrait {
			margin-inline: auto;
		}

		.pain-points-copy {
			align-items: center;
		}

		.pain-item {
			justify-content: center;
		}

		.pain-points-stamp {
			right: 1rem;
		}
	}
</style>
