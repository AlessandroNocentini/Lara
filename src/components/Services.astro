---
import ServiceIcon from "./ServiceIcon.astro";
import PlaceholderImage from "./PlaceholderImage.astro";
import { splitHighlighted } from "../utils/highlightText";
import { withBase } from "../utils/baseUrl";
import type { ServicesContent } from "../types/content";

interface Props {
  content: ServicesContent;
}

const { content } = Astro.props;

const titleParts = splitHighlighted(content.title, ["Learn"]);

// Fixed decorative accent colors tied to card position (not admin-editable
// data), same positional-array convention as Pain Points'/Lessons-Different's
// icon arrays.
const cardTints = ["var(--color-primary-light)", "var(--color-secondary-light)", "var(--color-tertiary-light)", "var(--color-primary-light)"];
const cardAccents = ["var(--color-primary)", "var(--color-secondary)", "var(--color-tertiary)", "var(--color-primary)"];
---

<section id="services" class="services">
	<div class="container services-top">
		<div class="services-copy">
			<h2 class="services-title">
				{titleParts.map((part) =>
					part.highlight ? (
						<span class="highlight">{part.text}</span>
					) : (
						<>{part.text}</>
					)
				)}
			</h2>
			<span
				class="services-heart-stamp"
				aria-hidden="true"
				style={`mask-image:url(${withBase("/images/heart_stamp.svg")});-webkit-mask-image:url(${withBase("/images/heart_stamp.svg")});`}
			></span>
		</div>
		<div class="services-portrait">
			<PlaceholderImage src={content.image || undefined} alt="Photo of Lara" variant="portrait" />
		</div>
	</div>

	<div class="container services-grid">
		<span
			class="services-star-stamp"
			aria-hidden="true"
			style={`mask-image:url(${withBase("/images/star_stamp.svg")});-webkit-mask-image:url(${withBase("/images/star_stamp.svg")});`}
		></span>
		{content.items.map((item, i) => (
			<article class="service-card" data-hover-lift>
				<span class="service-icon" style={`background: ${cardTints[i % cardTints.length]}`}>
					<ServiceIcon icon={item.icon} />
					<span class="service-icon-badge" style={`background: ${cardAccents[i % cardAccents.length]}`}></span>
				</span>
				<h3>{item.title}</h3>
				<span class="service-divider" style={`background: ${cardAccents[i % cardAccents.length]}`}></span>
				<p>{item.description}</p>
			</article>
		))}
	</div>
</section>

<style>
	.services {
		position: relative;
		background: var(--color-cream);
		padding: var(--section-padding);
		overflow: hidden;
	}

	.services-top {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.services-copy {
		position: relative;
		padding-top: 0.5rem;
	}

	.services-title {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		color: var(--color-primary-dark);
	}

	.services-title .highlight {
		color: var(--color-tertiary);
	}

	.services-heart-stamp {
		display: block;
		position: absolute;
		right: 10%;
		bottom: -2.5rem;
		width: 2.75rem;
		aspect-ratio: 13.4944 / 15.394346;
		background-color: var(--color-tertiary);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.9;
		pointer-events: none;
		z-index: 0;
	}

	.services-portrait {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 26rem;
		margin-left: auto;
	}

	.services-portrait :global(.placeholder-image) {
		/* Capped by height (not width) and right-aligned within the
		   container, so shrinking it doesn't affect .services-portrait's
		   own layout/position in the grid. ~1/3 of the previous rendered
		   height (was ~599px at this column width). */
		width: auto;
		max-height: 12.5rem;
		margin-left: auto;
		display: block;
		rotate: -3deg;
		/* Sticker effect, same technique as Hero.astro's portrait: a white
		   outline that hugs the photo's own alpha silhouette rather than a
		   rectangular/circular crop. Each 0-blur drop-shadow stamps a solid
		   white copy of the image offset in one direction; stacking a ring
		   of them builds a continuous halo that follows the cutout edge. */
		filter:
			drop-shadow(3px 0 0 white)
			drop-shadow(-3px 0 0 white)
			drop-shadow(0 3px 0 white)
			drop-shadow(0 -3px 0 white)
			drop-shadow(2.2px 2.2px 0 white)
			drop-shadow(-2.2px 2.2px 0 white)
			drop-shadow(2.2px -2.2px 0 white)
			drop-shadow(-2.2px -2.2px 0 white);
	}

	.services-grid {
		position: relative;
		z-index: 2;
		margin-top: -6rem;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.75rem;
	}

	.services-star-stamp {
		display: block;
		position: absolute;
		left: -1.5rem;
		top: -1rem;
		width: 3rem;
		aspect-ratio: 15.257332 / 19.88335;
		background-color: var(--color-tertiary);
		mask-repeat: no-repeat;
		mask-position: center;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center;
		-webkit-mask-size: contain;
		opacity: 0.9;
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 900px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 800px) {
		.services-top {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.services-copy {
			padding-top: 0;
		}

		.services-heart-stamp {
			right: 1rem;
		}

		.services-portrait {
			max-width: 18rem;
			margin-inline: auto;
		}

		.services-grid {
			margin-top: 3rem;
		}

		.services-star-stamp {
			left: 1rem;
		}
	}

	@media (max-width: 560px) {
		.services-grid {
			grid-template-columns: 1fr;
		}
	}

	.service-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.6rem;
		background: var(--color-white);
		border-radius: var(--radius-md);
		padding: 1.75rem;
		box-shadow: var(--shadow-soft);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.service-icon {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius-full);
		color: var(--color-white);
		margin-bottom: 0.25rem;
	}

	.service-icon-badge {
		position: absolute;
		right: -0.2rem;
		bottom: -0.2rem;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: var(--radius-full);
		border: 2px solid var(--color-white);
	}

	.service-card h3 {
		font-size: 1.15rem;
		color: var(--color-primary-dark);
	}

	.service-divider {
		width: 2.25rem;
		height: 3px;
		border-radius: var(--radius-full);
	}

	.service-card p {
		color: var(--color-ink-soft);
		font-size: 0.95rem;
	}
</style>
